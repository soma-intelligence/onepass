{
  "manifest_version": 3,
  "name": "OnePass",
  "version": "0.1.0",
  "description": "OnePass password manager",
  "permissions": ["storage", "nativeMessaging", "webNavigation", "scripting", "activeTab"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "web_accessible_resources": [
    {
      "resources": ["menu.html", "overlay.html", "save.html", "menu.js", "overlay.js", "save.js"],
      "matches": ["https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
