# Pinned Android build tooling for the Rust core (plan X4, Task 1).
# Sourced by build-core.sh, test-core-emulator.sh and .github/workflows/android.yml.
# The Rust toolchain itself is pinned in core/rust-toolchain.toml.
ANDROID_NDK_VERSION=29.0.14206865
CARGO_NDK_VERSION=4.1.2
# Lowest Android supported (minSdk 29, Android 10).
ANDROID_MIN_API=29
# Emulator system images for the core tests: x86_64 in CI (KVM on Linux),
# arm64-v8a on Apple Silicon Macs (x86_64 images do not run there).
ANDROID_TEST_IMAGE_X86_64="system-images;android-29;default;x86_64"
ANDROID_TEST_IMAGE_ARM64="system-images;android-29;default;arm64-v8a"
