(* OnePass formal model: account key rotation anchored in device keys
   (spec docs/superpowers/specs/2026-10-28-key-rotation-v2-design.md).
   Shared declarations and processes of rotation.pv and its two negative
   controls (rotation_autofollow.pv, rotation_account_anchor.pv). Each
   model defines its own follow_rotation process (the part the variants change),
   its queries and its main process.

   Status: design model, written before the implementation; since Task 20
   its processes and events carry the names of the Rust code:
   rotate = Repository::rotate, follow_rotation = repo/follow.rs
   follow_rotation, open_key_delivery = repo/rotate.rs open_key_delivery,
   restore_from_kit = repo/kit.rs restore_from_kit, RotationSigned =
   lineage sign_rotation, CommitAdoption = follow.rs commit_adoption,
   KitRestored = kit.rs KitRestored, RecreatedVault* = the recreated vault
   of lineage recreated_vault_id. Queries are unchanged.

   Cast (spec section 2):
   - devA, devC: honest devices of the account. Their device keys (hybrid
     signing key and hybrid KEM key) are created on the device and never
     leave it.
   - devB: the revoked device, fully compromised. The attacker holds its
     device signing key and device KEM key, the master password and every
     secret of the identity before the rotation (Secret Key, keyset with
     the identity key). The pre-rotation identity is therefore not modeled
     as an honest party at all: the attacker can build any record "of" it.
   - the storage (CloudKit) is the public channel c, hostile.

   Pinning (spec 5.1): each honest device pins the device public keys of
   the others through the SAS-verified pairing channel (proved in
   bridge.pv for the bridge, same construction for pairing). Here the
   pins are the private table `pinned`, filled by the setup and by the
   honest processes, never by the attacker: pinned(me, head, signer_id,
   signer_pub) means "at lineage head `head`, device `me` trusts
   `signer_id` with key `signer_pub`". A revoked or excluded device is
   simply absent from the view.

   User (spec 7.2): the user remembers what they did. Every rotation a
   user really started on an honest device inserts (signer, revoked) in
   the private table `userDid`. Following a rotation shows the signer's
   pinned name and the revoked names, and the user confirms only a
   summary that matches something they did. This is the only arbiter of
   the race "A revokes B" against "B revokes A" (ruling R6).

   The new Emergency Kit (spec 9) is the private table `kit`: the user
   keeps the Secret Key it prints.

   Abstractions:
   - one vault per rotation, its content reduced to one item; item keys
     and manifest history are account.pv's and manifest.pv's job;
   - a roster of exactly two entries (the rotator and one other device):
     enough for one remaining device to follow;
   - params: (identity_pub, message, identity signature), the message
     being (account id, salt, signing pub, KEM pubs); the params epoch and
     the Argon2 costs are not modeled;
   - two generations: A rotates from the genesis head (gen 1, revoking B),
     C follows and may rotate again (gen 2, revoking nobody), A follows
     gen 2. ProVerif processes are not recursive, deeper lineages repeat
     the same steps;
   - quarantine (a device that reads its own revocation), sibling
     ordering, re-application and convergence are not modeled (spec 8 and
     the Rust property tests of the plan cover them). *)

(* ------------------------------------------------------------------ *)
(* Names                                                               *)
(* ------------------------------------------------------------------ *)

(* The account id (public) and the genesis lineage head. *)
const acct: bitstring.
const h_genesis: bitstring.
(* Device ids, public. *)
const devA: bitstring.
const devB: bitstring.
const devC: bitstring.
(* "Nobody revoked". *)
const no_dev: bitstring.
(* Restoring devices (Emergency Kit), one per kit. *)
const restore_new: bitstring.
const restore_old: bitstring.

(* Signature domains and KEM label of the spec, section 6:
   "onepass/rotation/v1" (rotator device key),
   "onepass/rotation/identity/v1" (new identity, proof of possession),
   "onepass/rotation/secret-key/v1" (Secret Key delivery). *)
const dom_rotation: bitstring.
const dom_rotation_id: bitstring.
const lbl_sk_delivery: bitstring.

(* The master password is known to the revoked device. *)
free pw: password.
(* The Secret Key before the rotation, also known to it (old kit). *)
free sk_old: key.

(* ------------------------------------------------------------------ *)
(* Terms                                                               *)
(* ------------------------------------------------------------------ *)

(* RosterEntry { device_id, sign_pub, kem_pub } (name, kind, mode are
   display data, not modeled). *)
fun ros_entry(bitstring, pkey, mlkem_pk, x25519_pk): bitstring [data].

(* RotationBody { account_id, parent, rotator, new identity_pub, revoked,
   roster, params_hash } (spec 6.2; generation, from_heads, deliveries
   list and reason are not modeled: generation is implied by parent). *)
fun rr_body(bitstring, bitstring, bitstring, pkey, bitstring, bitstring,
            bitstring): bitstring [data].

(* core/onepass-core/src/account.rs: keyset_aad, blob id = account id. *)
letfun keyset_aad_r(a: bitstring) = blob_aad(kind_keyset, a, no_vault).
letfun vault_ctx(vid: bitstring) = (ctx_vault, vid).
letfun manifest_aad_r(vid: bitstring) = blob_aad(kind_manifest, vid, vid).
letfun item_aad_r(vid: bitstring) = blob_aad(kind_item, vid, vid).
(* KEM context of a Secret Key delivery: account, rotation hash,
   recipient device id. *)
letfun delivery_ctx(hb: bitstring, rcpt: bitstring) = (acct, hb, rcpt).

(* ------------------------------------------------------------------ *)
(* Tables (private by construction: the attacker never reads or       *)
(* writes a table).                                                    *)
(* ------------------------------------------------------------------ *)

table pinned(bitstring, bitstring, bitstring, pkey).
table userDid(bitstring, bitstring).
table kit(pkey, key).
(* The lineage head a rotator moved to, so its follower process starts
   there. *)
table heads(bitstring, bitstring).

(* ------------------------------------------------------------------ *)
(* Events                                                              *)
(* ------------------------------------------------------------------ *)

(* An honest device rotated: signer, new identity pub, revoked device,
   roster, new Secret Key, new identity secret. *)
event RotationSigned(bitstring, pkey, bitstring, bitstring, key, skey).
(* Device `dev` adopted the identity `ip` introduced by `signer`. *)
event CommitAdoption(bitstring, bitstring, pkey).
(* An item written under the new keys, by the rotator or a follower. *)
event ItemSealedNew(bitstring, bitstring).
(* A vault created under a new identity / accepted by a follower. *)
event RecreatedVaultCreated(pkey, bitstring, key).
event RecreatedVaultAccepted(bitstring, pkey, bitstring, key).
(* A device restored from a kit pinned this identity and roster. *)
event KitRestored(bitstring, pkey, bitstring).

(* ------------------------------------------------------------------ *)
(* Rotation by an honest device (spec 6.3, phases 1 and 2).           *)
(* signer: device id; dsk: its device signing key; parent: the lineage *)
(* head it rotates from; revoked: the device it removes; roster: the  *)
(* two devices trusted afterwards, each receiving the new Secret Key  *)
(* sealed to its device KEM key.                                       *)
(* ------------------------------------------------------------------ *)
let rotate(signer: bitstring, dsk: skey, parent: bitstring,
           revoked: bitstring, roster: bitstring) =
  new skn: key; new idk: skey; new ssk: skey; new km: seed; new kx: seed;
  new salt_n: nonce;
  let salt = n2b(salt_n) in
  let pmsg = (acct, salt, pk(ssk), kem_pk_m(km), kem_pk_x(kx)) in
  let params = (pk(idk), pmsg, sign_dom(idk, dom_account_params, pmsg)) in
  let body = rr_body(acct, parent, signer, pk(idk), revoked, roster, h(params)) in
  let hb = h(body) in
  (* Keyset of the new identity under AUK(password, new Secret Key). *)
  let ks = aead_seal(derive_auk(pw, skn, salt), keyset_aad_r(acct),
                     (km, kx, ssk, idk)) in
  let (ros_entry(i1: bitstring, s1: pkey, m1: mlkem_pk, x1: x25519_pk),
       ros_entry(i2: bitstring, s2: pkey, m2: mlkem_pk, x2: x25519_pk)) = roster in
  new r1m: seed; new r1x: seed; new r2m: seed; new r2x: seed;
  let d1 = core_wrap_labeled(m1, x1, r1m, r1x, lbl_sk_delivery, delivery_ctx(hb, i1), skn) in
  let d2 = core_wrap_labeled(m2, x2, r2m, r2x, lbl_sk_delivery, delivery_ctx(hb, i2), skn) in
  event RotationSigned(signer, pk(idk), revoked, roster, skn, idk);
  (* The user did this, and keeps the new kit. *)
  insert userDid(signer, revoked);
  insert kit(pk(idk), skn);
  (* The rotator's own view at its new head: the roster. *)
  insert pinned(signer, hb, i1, s1);
  insert pinned(signer, hb, i2, s2);
  insert heads(signer, hb);
  (* Phase 1: rotation record (device and identity signatures), params,
     keyset, deliveries. *)
  out(c, (body, sign_dom(dsk, dom_rotation, body), sign_dom(idk, dom_rotation_id, body),
          params, ks, d1, d2));
  (* Phase 2: vault content re-encrypted under a fresh vault key. *)
  new vid_n: nonce; new vk: key; new rvm: seed; new rvx: seed; new content: bitstring;
  let vid = n2b(vid_n) in
  let env = core_wrap(kem_pk_m(km), kem_pk_x(kx), rvm, rvx, vault_ctx(vid), vk) in
  let mb = aead_seal(vk, manifest_aad_r(vid), vid) in
  event RecreatedVaultCreated(pk(idk), vid, vk);
  event ItemSealedNew(signer, content);
  out(c, (vid, env, mb, sign_dom(ssk, dom_manifest, mb),
          aead_seal(vk, item_aad_r(vid), content))).

(* ------------------------------------------------------------------ *)
(* Rotation record checks shared by the follower processes.            *)
(* ------------------------------------------------------------------ *)

(* After the record is accepted: open the delivery addressed to `me`
   with its device KEM key, check the params against the record, open
   the keyset under AUK(password, delivered Secret Key) and check that it
   holds the identity the record names. Returns the new keys. *)
letfun open_key_delivery(me: bitstring, dkm: seed, dkx: seed, body: bitstring,
                     ip: pkey, ph: bitstring, params: bitstring,
                     ks: bitstring, deliv: bitstring) =
  let skn = core_unwrap_labeled(dkm, dkx, lbl_sk_delivery,
                                delivery_ctx(h(body), me), deliv) in
  let (=ip, pmsg: bitstring, psig: bitstring) = params in
  if h(params) = ph then
  if verify_dom(ip, dom_account_params, pmsg, psig) = true then
  let (=acct, salt: bitstring, spub: pkey, pkm: mlkem_pk, pkx: x25519_pk) = pmsg in
  let (km: seed, kx: seed, ssk: skey, idk: skey) =
    aead_open(derive_auk(pw, skn, salt), keyset_aad_r(acct), ks) in
  if pk(idk) = ip then
  if pk(ssk) = spub then
  if kem_pk_m(km) = pkm then
  if kem_pk_x(kx) = pkx then
  (km, kx, ssk).

(* After adoption: accept a vault of the new identity (its manifest is
   signed by the new signing key and opens under the vault key) and write
   an item in it. *)
let use_recreated_vault(me: bitstring, ip: pkey, km: seed, kx: seed, ssk: skey) =
  in(c, (vid: bitstring, env: bitstring, mb: bitstring, ms: bitstring));
  let vk = core_unwrap(km, kx, vault_ctx(vid), env) in
  if verify_dom(pk(ssk), dom_manifest, mb, ms) = true then
  if aead_open(vk, manifest_aad_r(vid), mb) = vid then
  event RecreatedVaultAccepted(me, ip, vid, vk);
  new wcontent: bitstring;
  event ItemSealedNew(me, wcontent);
  out(c, aead_seal(vk, item_aad_r(vid), wcontent)).

(* ------------------------------------------------------------------ *)
(* Restore with an Emergency Kit on a device that pinned nothing       *)
(* (spec 7.6): the identity is authenticated by 2SKD (the keyset must   *)
(* open under the kit's Secret Key and the password and hold the       *)
(* identity of the record), the roster by the identity signature over  *)
(* the record. No device key is checked: the device has none pinned.   *)
(* ------------------------------------------------------------------ *)
let restore_from_kit(rtag: bitstring, skk: key) =
  in(c, (body: bitstring, sid: bitstring, params: bitstring, ks: bitstring));
  let rr_body(=acct, parent: bitstring, signer: bitstring, ip: pkey,
              revoked: bitstring, roster: bitstring, ph: bitstring) = body in
  if verify_dom(ip, dom_rotation_id, body, sid) = true then
  let (=ip, pmsg: bitstring, psig: bitstring) = params in
  if h(params) = ph then
  if verify_dom(ip, dom_account_params, pmsg, psig) = true then
  let (=acct, salt: bitstring, spub: pkey, pkm: mlkem_pk, pkx: x25519_pk) = pmsg in
  let (km: seed, kx: seed, ssk: skey, idk: skey) =
    aead_open(derive_auk(pw, skk, salt), keyset_aad_r(acct), ks) in
  if pk(idk) = ip then
  event KitRestored(rtag, ip, roster).

(* The latest kit (a Secret Key the user printed at a rotation). *)
let restore_latest_kit = get kit(ipk, skk) in restore_from_kit(restore_new, skk).
(* An outdated kit from before the rotation: its Secret Key is the one
   the revoked device holds. *)
let restore_outdated_kit = restore_from_kit(restore_old, sk_old).
