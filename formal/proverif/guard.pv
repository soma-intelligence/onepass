(* formal-lib: guard_core.pvl *)
(* Guarded Kit: kit stolen, storage hostile, realm 1 compromised (T - 1 = 1
   realm). Pinned response keys.

   G1: no offline guessing of the password (weaksecret pw).
   G2: the keyset stays secret.
   G3: offline, the attacker cannot evaluate the OPRF (one key share only).
   G4: no restoring device derives its tags under an attacker's OPRF key.
   Sanity: the honest restore goes to the end. *)

free pw: password [private].

query attacker(keyset_secret).
query attacker(evalb(guard_oprf_key, late)).
query x: bitstring; event(DeviceOprf(oprf(evil, x))).
query event(Restored(keyset_secret)).
weaksecret pw.

process
  new sk: key; new salt: nonce;
  new rsk1: skey; new rsk2: skey; new rsk3: skey;
  out(c, (sk, salt, pk(rsk1), pk(rsk2), pk(rsk3)));
  ( Guarded(pw, sk, n2b(salt), guard_oprf_key, rsk1, rsk2, rsk3, yes, no)
  | ! Restore(pw, sk, n2b(salt), pk(rsk1), pk(rsk2))
  | phase 1; out(c, late) )
