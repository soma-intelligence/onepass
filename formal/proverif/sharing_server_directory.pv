(* formal-lib: sharing_core.pvl *)
(* OnePass formal model, negative control of sharing.pv: the owner takes
   the members' keys from the server (spec 5.1 approach A, the directory
   of 1Password and Bitwarden), not from contacts verified over an
   authenticated channel. Everything else is sharing.pv: signed
   membership, key_commit, envelopes, removal at g2.

   Expected: the server answers with keys of its own, Alice wraps every
   generation for them and signs them into the membership; the vault
   falls (attack A1). This is why a key only enters the book through the
   face to face channel or the invite link (spec 5.3, P1). *)

(* Expected false: the key of generation 1, and what is written after the
   removal, reach the server. *)
query v: bitstring, k: key; event(GenerationCreated(v, g1, k)) && attacker(k) phase 0.
query m: bitstring; event(ItemSealedAfterRemoval(m)) && attacker(m) phase 1.
(* Sanity (expected false): the vault is created. *)
query v: bitstring, k: key; event(GenerationCreated(v, g1, k)).

process
  new skA: skey; new kmA: seed; new kxA: seed;
  new skB: skey; new kmB: seed; new kxB: seed;
  new skC: skey; new kmC: seed; new kxC: seed;
  new skD: skey; new kmD: seed; new kxD: seed;
  out(c, (pk(skA), kem_pk_m(kmA), kem_pk_x(kxA),
          pk(skB), kem_pk_m(kmB), kem_pk_x(kxB),
          pk(skC), kem_pk_m(kmC), kem_pk_x(kxC),
          pk(skD), kem_pk_m(kmD), kem_pk_x(kxD)));
  new k1: key; new k2: key;
  let eA = entry_alice(skA, kmA, kxA) in
  ( (* The server's answer for "bob", "carol" and "dave", trusted as is. *)
    (in(c, (sB: pkey, mB: mlkem_pk, xB: x25519_pk, sC: pkey, mC: mlkem_pk, xC: x25519_pk,
            sD: pkey, mD: mlkem_pk, xD: x25519_pk));
     Owner(skA, eA, sB, mB, xB, lvl_verified, sC, mC, xC, lvl_verified,
           sD, mD, xD, lvl_link, k1, k2, true))
  | MemberJoin(true, bob, skB, kmB, kxB, true, alice, pk(skA))
  | (phase 1; out(c, (skC, kmC, kxC))) )
