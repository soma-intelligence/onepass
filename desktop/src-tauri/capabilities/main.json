{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The one window with capabilities: the app's own commands and event listening, nothing else (no fs, shell, http or opener plugin).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-status",
    "allow-create-account",
    "allow-unlock",
    "allow-lock",
    "allow-vaults",
    "allow-items",
    "allow-item",
    "allow-item-types",
    "allow-new-item",
    "allow-save-item",
    "allow-trash-item",
    "allow-set-favorite",
    "allow-reveal-field",
    "allow-copy-field",
    "allow-totp",
    "allow-generate-password",
    "allow-watchtower",
    "allow-set-archived",
    "allow-restore-item",
    "allow-delete-item",
    "allow-move-item",
    "allow-duplicate-item",
    "allow-password-history",
    "allow-history-value",
    "allow-save-vault",
    "allow-delete-vault",
    "allow-change-password",
    "allow-account",
    "allow-set-profile-name",
    "allow-strength",
    "allow-copy-secret",
    "allow-open-url",
    "allow-add-attachment",
    "allow-remove-attachment",
    "allow-open-attachment",
    "allow-export-attachment",
    "allow-hello-status",
    "allow-enable-hello",
    "allow-disable-hello",
    "allow-unlock-with-hello",
    "allow-save-pending",
    "allow-discard-pending",
    "allow-export-backup",
    "allow-export-csv",
    "allow-pick-backup",
    "allow-pending-archive",
    "allow-preview-restore",
    "allow-restore-backup",
    "allow-forget-file",
    "allow-pick-import",
    "allow-preview-import",
    "allow-import-items",
    "allow-set-check-breaches"
  ]
}
