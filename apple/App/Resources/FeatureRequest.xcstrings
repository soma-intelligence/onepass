    "featureRequest.error.network" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Senden fehlgeschlagen. Prüfe deine Verbindung und versuche es erneut. Dein Text bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
