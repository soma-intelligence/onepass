    "featureRequest.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Idee und deine E-Mail-Adresse, falls du eine angibst, werden an Soma Labs gesendet. Aus deinem Tresor wird nichts gesendet."
