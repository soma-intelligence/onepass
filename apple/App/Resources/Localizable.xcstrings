    "developer.noKeyOfferedTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dem Agenten stehen keine Schlüssel zur Verfügung. Aktiviere bei einem SSH-Schlüssel „Im SSH-Agenten verwenden“ oder erstelle einen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No key is offered to the agent. Turn on “Use in SSH agent” on an SSH key, or create one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ofrece ninguna clave al agente. Activa «Usar en el agente SSH» en una clave SSH, o crea una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé n'est proposée à l'agent. Active « Utiliser dans l'agent » sur une clé SSH, ou crée-en une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna chiave è offerta all'agente. Attiva «Usa nell'agente SSH» su una chiave SSH, oppure creane una."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트에 제공되는 키가 없어요. SSH 키에서 ‘에이전트에서 사용’을 켜거나 새 키를 만드세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
