    "root.deviceTakesWhatIcloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Gerät übernimmt den Inhalt aus iCloud. Eine signierte Wiederherstellung wird protokolliert. Die Erkennung bleibt aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device takes what iCloud holds. A signed restore is recorded, and detection stays on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo adopta lo que contiene iCloud. Se registra una restauración firmada y la detección sigue activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil adopte ce qu'iCloud contient. Une restauration signée est enregistrée, et la détection reste active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo adotta ciò che contiene iCloud. Viene registrato un ripristino firmato e il rilevamento resta attivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기에 iCloud의 내용을 적용해요. 서명된 복원이 기록되고 감지는 계속 활성화돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此设备将采用 iCloud 中的内容。系统会保存一条已签名的恢复记录，检测仍保持开启。"
          }
        }
      }
    },
    "root.devicesVerifiedCopyReplaces" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die überprüfte Kopie dieses Geräts ersetzt die Kopie in iCloud. Deine anderen Geräte erhalten sie anschließend. Eine signierte Wiederherstellung wird protokolliert. Die Erkennung bleibt aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device's verified copy replaces iCloud's. Your other devices receive it next. A signed restore is recorded, and detection stays on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia verificada de este dispositivo sustituye a la de iCloud. Tus otros dispositivos la reciben después. Se registra una restauración firmada y la detección sigue activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie vérifiée de cet appareil remplace celle d'iCloud. Tes autres appareils la reçoivent ensuite. Une restauration signée est enregistrée, et la détection reste active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia verificata di questo dispositivo sostituisce quella di iCloud. Gli altri dispositivi la ricevono subito dopo. Viene registrato un ripristino firmato e il rilevamento resta attivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기의 검증된 사본으로 iCloud의 사본을 대체해요. 그런 다음 다른 기기에도 전달돼요. 서명된 복원이 기록되고 감지는 계속 활성화돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此设备上已验证的副本将替换 iCloud 中的副本。你的其他设备随后会收到此副本。系统会保存一条已签名的恢复记录，检测仍保持开启。"
          }
        }
      }
    },
    "root.eachVaultCarriesSigned" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeder Tresor enthält eine signierte Liste seiner Objekte und eine Versionsnummer. Kelid prüft diese Signaturen bei jedem Lesevorgang. Entfernte, hinzugefügte oder veränderte Objekte sowie alte Versionen, die vom Speicher oder von iCloud erneut eingespielt werden, werden zurückgewiesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each vault carries a signed list of its items and a version number. Kelid checks these signatures on every read, so an item removed, added or changed, or an old version replayed by storage or iCloud, is refused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bóveda lleva una lista firmada de sus elementos y un número de versión. Kelid comprueba estas firmas en cada lectura: se rechaza un elemento quitado, añadido o modificado, o una versión antigua reenviada por el almacenamiento o por iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque coffre porte une liste signée de ses éléments et un numéro de version. Kelid vérifie ces signatures à chaque lecture : un élément retiré, ajouté, modifié ou une ancienne version rejouée par le stockage ou par iCloud est refusé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cassaforte porta un elenco firmato dei suoi elementi e un numero di versione. Kelid verifica queste firme a ogni lettura: un elemento rimosso, aggiunto o modificato, o una vecchia versione riproposta dall'archiviazione o da iCloud, viene rifiutato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 보관함에는 서명된 항목 목록과 버전 번호가 있어요. Kelid는 데이터를 읽을 때마다 서명을 확인해요. 저장소나 iCloud가 항목을 제거, 추가, 변경하거나 이전 버전을 다시 제공하면 이를 거부해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个保险库都包含已签名的项目列表和版本号。Kelid 每次读取时都会验证这些签名：如果存储系统或 iCloud 移除、添加或修改了项目，或重放了旧版本，Kelid 都会拒绝接受。"
          }
        }
      }
    },
