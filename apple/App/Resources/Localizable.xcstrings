        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraseñas, llaves de acceso, tarjetas y documentos, cifrados en tu %@ con una criptografía que resiste a los ordenadores cuánticos."
          }
        },
        "it" : {
          "stringUnit" : {
