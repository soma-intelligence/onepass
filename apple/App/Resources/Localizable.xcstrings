    "accounts.add.kind.footer" : {
      "comment" : "Add Account: footer of the kind choice.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A separate account, with its own master password and Secret Key. Switch between accounts from the account menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta separada, con su contraseña maestra y su Secret Key. Cambia de una a otra desde el menú de la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte séparé, avec son mot de passe maître et sa Secret Key. Tu passes de l'un à l'autre depuis le menu du compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un account separato, con la sua password principale e la sua Secret Key. Passi dall'uno all'altro dal menu dell'account."
          }
        }
      }
    },
