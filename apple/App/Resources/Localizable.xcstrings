      }
    },
    "Touche le code pour l'afficher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tippe auf den Code, um ihn einzublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the code to show it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el código para mostrarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il codice per mostrarlo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "코드를 탭하면 표시돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "轻点验证码以显示。"
          }
        }
      }
    },
    "Touche un champ d'identifiant : Kelid apparaît au-dessus du clavier et se déverrouille par %@ ou ton mot de passe maître avant de remplir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tippe auf ein Anmeldefeld. Kelid erscheint über der Tastatur und wird vor dem Ausfüllen mit %@ oder deinem Master-Passwort entsperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a sign-in field. Kelid appears above the keyboard and unlocks with %@ or your master password before filling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un campo de inicio de sesión: Kelid aparece encima del teclado y se desbloquea con %@ o tu contraseña maestra antes de rellenar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un campo di accesso: Kelid compare sopra la tastiera e si sblocca con %@ o con la password principale prima di compilare."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로그인 필드를 탭해요. 키보드 위에 Kelid가 나타나고, %@ 또는 마스터 암호로 잠금을 해제한 후 정보를 채워요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "轻点登录信息栏，Kelid 会出现在键盘上方。填充前，使用 %@ 或你的主密码解锁。"
          }
        }
      }
    },
    "Tous les coffres redeviennent visibles. %@ reste désactivé jusqu'à ce que tu le réactives avec ton mot de passe maître." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle Tresore werden wieder sichtbar. %@ bleibt deaktiviert, bis du es mit deinem Master-Passwort wieder aktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All vaults become visible again. %@ stays off until you turn it back on with your master password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las bóvedas vuelven a ser visibles. %@ sigue desactivado hasta que lo vuelvas a activar con tu contraseña maestra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le casseforti tornano visibili. %@ resta disattivato finché non lo riattivi con la password principale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 보관함이 다시 표시돼요. %@ 기능은 마스터 암호로 다시 켤 때까지 꺼진 상태로 유지돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "所有保险库将重新显示。%@ 会保持关闭，直到你使用主密码重新启用。"
          }
        }
      }
    },
    "Tous les éléments" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle Objekte"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Items"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los elementos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli elementi"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 항목"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "所有项目"
          }
        }
      }
    },
    "Tous tes mots de passe, passkeys, cartes et documents, chiffrés avec une cryptographie qui résiste aux ordinateurs quantiques." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle deine Passwörter, Passkeys, Karten und Dokumente, verschlüsselt mit Kryptografie, die Quantencomputern standhält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your passwords, passkeys, cards and documents, encrypted with cryptography that stands up to quantum computers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas tus contraseñas, llaves de acceso, tarjetas y documentos, cifrados con una criptografía que resiste a los ordenadores cuánticos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le tue password, passkey, carte e documenti, cifrati con una crittografia che resiste ai computer quantistici."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 암호, 패스키, 카드, 문서를 양자 컴퓨터의 공격에도 견디는 암호화 기술로 보호해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的所有密码、通行密钥、卡片和文档，均采用可抵御量子计算机攻击的加密技术保护。"
          }
        }
      }
    },
    "Tout est chiffré avant de quitter cet appareil. iCloud ne voit que des données illisibles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles wird verschlüsselt, bevor es dieses Gerät verlässt. iCloud sieht nur unlesbare Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is encrypted before it leaves this device. iCloud only sees unreadable data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se cifra antes de salir de este dispositivo. iCloud solo ve datos ilegibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto viene cifrato prima di lasciare questo dispositivo. iCloud vede solo dati illeggibili."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 데이터는 이 기기를 떠나기 전에 암호화돼요. iCloud에는 읽을 수 없는 데이터만 보여요."
          }
        },
        "zh-Hans" : {
