            "value" : "Demande de copie expirée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesta di copia scaduta"
          }
        }
      }
    },
    "root.deviceTakesWhatIcloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device takes what iCloud holds. A signed restore is recorded, and detection stays on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo adopta lo que contiene iCloud. Se registra una restauración firmada y la detección sigue activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil adopte ce qu'iCloud contient. Une restauration signée est enregistrée, et la détection reste active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo adotta ciò che contiene iCloud. Viene registrato un ripristino firmato e il rilevamento resta attivo."
          }
        }
      }
    },
    "root.devicesVerifiedCopyReplaces" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device's verified copy replaces iCloud's. Your other devices receive it next. A signed restore is recorded, and detection stays on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia verificada de este dispositivo sustituye a la de iCloud. Tus otros dispositivos la reciben después. Se registra una restauración firmada y la detección sigue activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie vérifiée de cet appareil remplace celle d'iCloud. Tes autres appareils la reçoivent ensuite. Une restauration signée est enregistrée, et la détection reste active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia verificata di questo dispositivo sostituisce quella di iCloud. Gli altri dispositivi la ricevono subito dopo. Viene registrato un ripristino firmato e il rilevamento resta attivo."
          }
        }
      }
    },
    "root.eachVaultCarriesSigned" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each vault carries a signed list of its items and a version number. OnePass checks these signatures on every read, so an item removed, added or changed, or an old version replayed by storage or iCloud, is refused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada bóveda lleva una lista firmada de sus elementos y un número de versión. OnePass comprueba estas firmas en cada lectura: se rechaza un elemento quitado, añadido o modificado, o una versión antigua reenviada por el almacenamiento o por iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque coffre porte une liste signée de ses éléments et un numéro de version. OnePass vérifie ces signatures à chaque lecture : un élément retiré, ajouté, modifié ou une ancienne version rejouée par le stockage ou par iCloud est refusé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cassaforte porta un elenco firmato dei suoi elementi e un numero di versione. OnePass verifica queste firme a ogni lettura: un elemento rimosso, aggiunto o modificato, o una vecchia versione riproposta dall'archiviazione o da iCloud, viene rifiutato."
          }
        }
      }
    },
    "root.encryptedBackup" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted Backup"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia de seguridad cifrada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde chiffrée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup cifrato"
          }
        }
      }
    },
    "root.encryptedOnepassArchiveOf" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An encrypted OnePass archive of everything this device holds, vaults and items in the trash included. It opens with the passphrase chosen here or with your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo cifrado de OnePass con todo lo que contiene este dispositivo, incluidas las bóvedas y los elementos de la papelera. Se abre con la frase de contraseña elegida aquí o con tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une archive OnePass chiffrée de tout ce que cet appareil contient, coffres et éléments à la corbeille compris. Elle s'ouvre avec la phrase de passe choisie ici ou avec ton compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivio OnePass cifrato di tutto ciò che contiene questo dispositivo, casseforti ed elementi nel cestino compresi. Si apre con la passphrase scelta qui o con il tuo account."
          }
        }
      }
    },
    "root.encryptedVaultWillUploaded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your encrypted vault will be uploaded to this iCloud account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda cifrada se subirá a esta cuenta de iCloud."
          }
        },
        "fr" : {
