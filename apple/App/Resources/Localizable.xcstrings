    "import.duplicates.subtitle" : {
      "comment" : "Import sheet: what the possible duplicates section is.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These items of the file look like items already in this vault. Exact copies are skipped and the others merged, unless you choose otherwise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos elementos del archivo se parecen a elementos que ya están en esta bóveda. Las copias exactas se omiten y las demás se fusionan, salvo que elijas otra cosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces éléments du fichier ressemblent à des éléments déjà dans ce coffre. Les copies exactes sont ignorées et les autres fusionnées, sauf si tu choisis autrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi elementi del file somigliano a elementi già presenti in questa cassaforte. Le copie esatte vengono saltate e le altre unite, a meno che tu non scelga diversamente."
          }
        }
      }
    },
    "import.duplicates.suggested" : {
      "comment" : "Import sheet: put every possible duplicate back on its suggested choice.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerencias"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggeriti"
          }
        }
      }
    },
    "Importer" : {
      "localizations" : {
