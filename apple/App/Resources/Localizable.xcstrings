    "Dès que Kelid quitte l'écran. Face ID ou ton mot de passe le rouvrent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sobald Kelid nicht mehr auf dem Bildschirm ist. Mit Face ID oder deinem Passwort entsperrst du es wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as Kelid leaves the screen. Face ID or your password opens it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cuanto Kelid sale de la pantalla. Face ID o tu contraseña lo vuelven a abrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appena Kelid lascia lo schermo. Face ID o la tua password lo riaprono."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kelid가 화면에서 사라지면 바로 잠겨요. Face ID나 암호로 다시 열 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kelid 离开屏幕时立即锁定。使用 Face ID 或你的密码即可重新解锁。"
          }
        }
      }
    },
