    "developer.everySshSignatureAnd" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede SSH-Signatur und jeder MCP-Zugriff wird hier protokolliert, ob erlaubt oder abgelehnt. Das Protokoll ist verkettet und durch deinen Account signiert: Geänderte oder entfernte Zeilen sind erkennbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every SSH signature and every MCP access is recorded here, allowed or denied. The log is chained and signed by your account: an edited or removed line shows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada firma SSH y cada acceso MCP se registran aquí, permitidos o denegados. El registro está encadenado y firmado por tu cuenta: una línea modificada o eliminada se nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque signature SSH et chaque accès MCP y sont inscrits, acceptés ou refusés. Le journal est chaîné et signé par ton compte : une ligne modifiée ou retirée se voit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni firma SSH e ogni accesso MCP vengono registrati qui, consentiti o negati. Il registro è concatenato e firmato dal tuo account: una riga modificata o rimossa si vede."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 SSH 서명과 MCP 접근은 허용 여부와 관계없이 여기에 기록돼요. 로그는 연결된 형태로 계정에서 서명하므로, 수정되거나 삭제된 줄을 확인할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每次 SSH 签名和 MCP 访问都会记录在这里，无论获准还是被拒绝。日志以链式结构关联，并由你的账户签名：任何一行被修改或移除都能被发现。"
          }
        }
      }
    },
