    "settings.guard.explain" : {
      "comment" : "Turn the Emergency Kit protection on: what changes (spec 2026-11-20, sections 5, 6 and 9).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To restore your account with your Emergency Kit, Kelid will also need two of the three servers that Soma runs. They count the attempts. 15 attempts at most, then the kit is useless without one of your devices. Your devices unlock as before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para restaurar tu cuenta con tu Emergency Kit, Kelid también necesitará dos de los tres servidores que opera Soma. Cuentan los intentos. 15 intentos como máximo; después, el kit no sirve de nada sin uno de tus dispositivos. Tus dispositivos se desbloquean como antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour restaurer ton compte avec ton kit d'urgence, Kelid demandera aussi l'accord de deux des trois serveurs que Soma opère. Ils comptent les essais. 15 essais au plus, puis le kit ne sert plus à rien sans un de tes appareils. Tes appareils se déverrouillent comme avant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ripristinare il tuo account con il tuo Emergency Kit, Kelid avrà bisogno anche di due dei tre server gestiti da Soma. Contano i tentativi. 15 tentativi al massimo, poi il kit non serve più a nulla senza uno dei tuoi dispositivi. I tuoi dispositivi si sbloccano come prima."
          }
        }
      }
    },
    "settings.guard.failures" : {
      "comment" : "Réglages > Sécurité: alert when the realms logged failed restore attempts with the Emergency Kit; the dates follow.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone tried to restore your account with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien ha intentado restaurar tu cuenta con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu'un a essayé de restaurer ton compte avec ton kit d'urgence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno ha provato a ripristinare il tuo account con il tuo Emergency Kit."
          }
        }
      }
    },
    "settings.guard.loss" : {
      "comment" : "Turn the Emergency Kit protection on: the loss case of spec 8.4, stated before turning it on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you lose all your devices and two of these three servers are lost, your account can't be recovered, even with your kit and your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pierdes todos tus dispositivos y se pierden dos de estos tres servidores, tu cuenta será irrecuperable, incluso con tu kit y tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu perds tous tes appareils et que deux de ces trois serveurs sont perdus, ton compte est irrécupérable, même avec ton kit et ton mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdi tutti i tuoi dispositivi e due di questi tre server vanno persi, il tuo account è irrecuperabile, anche con il tuo kit e la tua password."
          }
        }
      }
    },
    "settings.guard.loss.header" : {
      "comment" : "Turn the Emergency Kit protection on: header of the loss case (spec 8.4).",
      "extractionState" : "manual",
