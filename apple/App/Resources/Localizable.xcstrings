    "browse.accountUseToSign" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Konto, mit dem du dich auf anderen Websites anmeldest, ist kompromittiert, hat ein schwaches oder mehrfach verwendetes Passwort oder keine Zwei-Faktor-Authentifizierung: Alle davon abhängigen Websites sind gefährdet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An account you use to sign in elsewhere is compromised, weak, reused or without two-factor authentication: every site that depends on it is exposed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta que usas para iniciar sesión en otros sitios está comprometida, es débil, está reutilizada o no tiene autenticación de doble factor: todos los sitios que dependen de ella están expuestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte qui te sert à te connecter ailleurs est compromis, faible, réutilisé ou sans double authentification : tous les sites qui en dépendent sont exposés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un account che usi per accedere altrove è compromesso, debole, riutilizzato o senza autenticazione a due fattori: tutti i siti che dipendono da esso sono esposti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다른 사이트에 로그인할 때 사용하는 계정이 유출되었거나, 암호가 취약하거나 재사용되거나, 이중 인증이 꺼져 있으면 해당 계정으로 로그인하는 모든 사이트가 위험해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你用于登录其他网站的账户存在泄露、密码强度低、密码重复使用或未启用双重认证的问题，所有依赖此账户的网站都面临风险。"
          }
        }
      }
    },
