    "settings.sync.migrate.explain" : {
      "comment" : "Migration sheet: what the move does.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your encrypted vault leaves iCloud for the OnePass Server. Your other Apple devices will offer to follow. The iCloud copy stays until you erase it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda cifrada deja iCloud y pasa al servidor de OnePass. Tus otros dispositivos Apple te propondrán seguirla. La copia de iCloud se queda hasta que la borres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton coffre chiffré quitte iCloud pour le serveur OnePass. Tes autres appareils Apple te proposeront de suivre. La copie iCloud reste en place jusqu'à ce que tu l'effaces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte cifrata lascia iCloud per il server OnePass. Gli altri tuoi dispositivi Apple ti proporranno di seguirla. La copia su iCloud resta finché non la cancelli."
          }
        }
      }
    },
