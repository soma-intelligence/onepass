    "root.syncPausedAndVault" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Synchronisierung ist pausiert. Dein Tresor bleibt auf diesem Gerät unverändert. Melde dich wieder beim ursprünglichen Account an oder verwende diesen Account."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is paused, and your vault stays intact on this device. Sign back in to the original account, or use this one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización está en pausa y tu bóveda sigue intacta en este dispositivo. Vuelve a iniciar sesión en la cuenta original o usa esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
