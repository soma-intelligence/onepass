        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra sus datos de Kelid en cuanto ve la lista de dispositivos. Podrás volver a añadirlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il efface ses données Kelid dès qu'il voit la liste des appareils. Tu pourras l'ajouter de nouveau plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella i suoi dati Kelid appena vede l'elenco dei dispositivi. Potrai aggiungerlo di nuovo più tardi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "해당 기기가 기기 목록을 확인하는 즉시 Kelid 데이터를 지워요. 나중에 다시 추가할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此设备获取设备列表后，会立即抹掉其 Kelid 数据。你可以稍后重新添加此设备。"
          }
        }
      }
