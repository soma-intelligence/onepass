    "settings.deleteAccount.confirmMessage" : {
      "comment" : "Réglages > Sécurité: delete account confirmation message",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Tresore, deine Objekte und dein Secret Key werden von diesem Gerät und aus iCloud gelöscht. Das lässt sich nicht rückgängig machen: Ohne ein anderes verknüpftes Gerät kann nichts wiederhergestellt werden, auch nicht mit deinem Emergency Kit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vaults, items and Secret Key will be erased from this device and from iCloud. This can't be undone: without another linked device, nothing can be restored, even with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus bóvedas, tus elementos y tu Secret Key se borrarán de este dispositivo y de iCloud. No se puede deshacer: sin otro dispositivo vinculado, no se podrá restaurar nada, ni siquiera con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes coffres, tes éléments et ta Secret Key seront effacés de cet appareil et d'iCloud. C'est définitif : sans autre appareil lié, rien ne pourra être restauré, même avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue casseforti, i tuoi elementi e la tua Secret Key verranno cancellati da questo dispositivo e da iCloud. Non si può annullare: senza un altro dispositivo collegato non si potrà ripristinare nulla, nemmeno con il tuo Emergency Kit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기와 iCloud에서 보관함, 항목, Secret Key가 삭제돼요. 이 작업은 되돌릴 수 없어요. 연결된 다른 기기가 없으면 Emergency Kit가 있어도 복원할 수 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的保险库、项目和 Secret Key 将从此设备和 iCloud 中抹掉。此操作无法撤销：如果没有其他关联设备，即使有 Emergency Kit，也无法恢复任何数据。"
          }
        }
      }
    },
