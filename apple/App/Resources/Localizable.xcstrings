    "settings.iphoneErasesKeyAnd %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses iPhone löscht seinen Schlüssel und %@ löscht seinen eigenen. Zum erneuten Aktivieren beginne noch einmal auf dem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone erases its key and %@ erases its own. To turn it on again, start over from the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone borra su clave y %@ borra la suya. Para volver a activarlo, empieza de nuevo desde el Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone efface sa clé et %@ efface la sienne. Pour le réactiver, recommence depuis le Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone cancella la sua chiave e %@ cancella la propria. Per riattivarlo, ricomincia dal Mac."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 iPhone과 %@에서 각각의 키를 지워요. 다시 활성화하려면 Mac에서 처음부터 시작하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这台 iPhone 和 %@ 都会抹掉各自的密钥。要重新启用，请在 Mac 上重新开始。"
          }
        }
      }
    },
    "settings.itErasesOnepassData" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Gerät löscht seine Kelid-Daten, sobald es die Geräteliste erhält. Du kannst es später wieder hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It erases its Kelid data as soon as it sees the device list. You can add it again later."
