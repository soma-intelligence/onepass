      "comment" : "Settings > Accounts: footer of the unified search toggle.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds \"Search All Accounts\" to the account menu. Only unlocked accounts are searched. Otherwise each account shows only its own items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade «Buscar en todas las cuentas» al menú de la cuenta. Solo se buscan las cuentas desbloqueadas. Si no, cada cuenta muestra solo sus elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute « Rechercher dans tous les comptes » au menu du compte. Seuls les comptes déverrouillés sont cherchés. Sinon, chaque compte ne montre que ses éléments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
