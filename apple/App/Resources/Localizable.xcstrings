    "developer.eachRequestAlsoGoes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Anfrage geht auch an dein iPhone. Die erste Antwort zählt. Das Zeitfenster für Agenten endet, wenn es abläuft, dieser Mac in den Ruhezustand wechselt oder du Kelid sperrst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each request also goes to your iPhone, and the first answer counts. The agent window closes when it ends, when this Mac goes to sleep or when you lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada solicitud llega también a tu iPhone, y cuenta la primera respuesta. La ventana de los agentes se cierra al terminar, cuando este Mac entra en reposo o cuando bloqueas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque demande part aussi vers ton iPhone, et la première réponse compte. La fenêtre des agents se ferme à son terme, quand ce Mac se met en veille ou quand tu verrouilles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni richiesta arriva anche su iPhone, e conta la prima risposta. La finestra degli agenti si chiude alla scadenza, quando questo Mac va in stop o quando blocchi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 요청은 iPhone에도 전송되며, 첫 번째 응답이 적용돼요. 에이전트 창은 시간이 만료되거나, 이 Mac이 잠자기 모드로 전환되거나, 잠그면 닫혀요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个请求也会发送到你的 iPhone，以最先收到的回复为准。智能体授权时段会在到期、此 Mac 进入睡眠或你锁定时结束。"
          }
        }
      }
    },
