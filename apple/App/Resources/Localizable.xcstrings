    "Mots de passe, passkeys, cartes et documents, chiffrés sur ton %@ avec une crypto qui résiste aux ordinateurs quantiques." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passwörter, Passkeys, Karten und Dokumente, auf deinem %@ quantenresistent verschlüsselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords, passkeys, cards and documents, encrypted on your %@ with crypto that stands up to quantum computers."
