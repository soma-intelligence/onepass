    "Appareil de la famille ou du bureau : pas de %@, verrouillage après 5 minutes, coffres visibles au choix." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Familien- oder Arbeitsgerät: kein %@, Sperre nach 5 Minuten. Du wählst, welche Tresore sichtbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A family or work device: no %@, locks after 5 minutes, you choose which vaults are visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo familiar o del trabajo: sin %@, se bloquea tras 5 minutos y eliges qué bóvedas se ven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo di famiglia o di lavoro: niente %@, si blocca dopo 5 minuti e scegli quali casseforti sono visibili."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "가족이나 회사 기기에서는 %@ 없이 사용하고, 5분 후에 잠겨요. 표시할 보관함을 선택할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "家庭或工作设备：不使用 %@，5 分钟后锁定，你可以选择显示哪些保险库。"
          }
        }
      }
    },
    "Appareil de la famille ou du bureau. Pas de %@, verrouillage après 5 min, coffres visibles au choix." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gerät für Familie oder Arbeit. Kein %@, Sperre nach 5 Min., sichtbare Tresore frei wählbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A family or work device. No %@, locks after 5 min, you choose which vaults are visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo familiar o del trabajo. Sin %@, se bloquea tras 5 min y eliges qué bóvedas se ven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo di famiglia o di lavoro. Niente %@, si blocca dopo 5 min e scegli quali casseforti sono visibili."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "가족이나 직장에서 함께 쓰는 기기예요. %@ 없이 5분 후 잠기며, 표시할 보관함을 선택할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
