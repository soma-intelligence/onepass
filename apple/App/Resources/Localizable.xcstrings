    "Cet iPhone efface sa clé et %@ efface la sienne. Pour le réactiver, recommence depuis le Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone erases its key and %@ erases its own. To turn it on again, start over from the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
