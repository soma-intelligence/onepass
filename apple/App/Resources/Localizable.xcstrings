    "Touche le code pour l'afficher." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the code to show it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el código para mostrarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il codice per mostrarlo."
          }
        }
      }
    },
    "Touche un champ d'identifiant : OnePass apparaît au-dessus du clavier et se déverrouille par %@ ou ton mot de passe maître avant de remplir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a sign-in field. OnePass appears above the keyboard and unlocks with %@ or your master password before filling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un campo de inicio de sesión: OnePass aparece encima del teclado y se desbloquea con %@ o tu contraseña maestra antes de rellenar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un campo di accesso: OnePass compare sopra la tastiera e si sblocca con %@ o con la password principale prima di compilare."
          }
        }
      }
    },
    "Tous les coffres redeviennent visibles. %@ reste désactivé jusqu'à ce que tu le réactives avec ton mot de passe maître." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All vaults become visible again. %@ stays off until you turn it back on with your master password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las bóvedas vuelven a ser visibles. %@ sigue desactivado hasta que lo vuelvas a activar con tu contraseña maestra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le casseforti tornano visibili. %@ resta disattivato finché non lo riattivi con la password principale."
          }
        }
      }
    },
    "Tous les éléments" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Items"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los elementos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli elementi"
          }
        }
      }
    },
    "Tous tes mots de passe, passkeys, cartes et documents, chiffrés avec une cryptographie qui résiste aux ordinateurs quantiques." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your passwords, passkeys, cards and documents, encrypted with cryptography that stands up to quantum computers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas tus contraseñas, llaves de acceso, tarjetas y documentos, cifrados con una criptografía que resiste a los ordenadores cuánticos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le tue password, passkey, carte e documenti, cifrati con una crittografia che resiste ai computer quantistici."
          }
        }
      }
    },
    "Tout est chiffré avant de quitter cet appareil. iCloud ne voit que des données illisibles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is encrypted before it leaves this device. iCloud only sees unreadable data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se cifra antes de salir de este dispositivo. iCloud solo ve datos ilegibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto viene cifrato prima di lasciare questo dispositivo. iCloud vede solo dati illeggibili."
          }
        }
      }
    },
