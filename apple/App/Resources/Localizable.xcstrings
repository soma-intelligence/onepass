    "settings.guard.newKit.footer" : {
      "comment" : "Turn the Emergency Kit protection on, done: offer of a new kit (spec 8.1).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print a new Emergency Kit. It says that restoring happens online, with limited attempts. Your old kit still works with your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime un nuevo Emergency Kit. Indica que la restauración se hace en línea, con intentos limitados. Tu kit anterior sigue funcionando con tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime un nouveau kit d'urgence. Il indique que la restauration se fait en ligne, avec des essais limités. Ton ancien kit reste valable avec ton mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stampa un nuovo Emergency Kit. Indica che il ripristino avviene online, con tentativi limitati. Il tuo vecchio kit funziona ancora con la tua password."
          }
        }
      }
    },
