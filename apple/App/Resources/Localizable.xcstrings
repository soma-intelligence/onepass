    "settings.about.updates.footer" : {
      "comment" : "Réglages > À propos (Mac): footer of the updates section, what the check sends",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Start und danach alle 24 Stunden fragt Kelid die neueste auf GitHub veröffentlichte Version ab. Die Anfrage enthält keine Kennung. Ein Update wird nur mit deiner Zustimmung installiert und nur, wenn es von Kelid signiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At launch and every 24 hours, Kelid reads the latest version published on GitHub. The request carries no identifier. An update installs only with your approval, and only if Kelid signed it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrirse y cada 24 horas, Kelid consulta la última versión publicada en GitHub. La solicitud no contiene ningún identificador. Una actualización solo se instala con tu permiso, y solo si Kelid la ha firmado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au lancement puis toutes les 24 heures, Kelid lit la dernière version publiée sur GitHub. La requête ne contient aucun identifiant. Une mise à jour ne s'installe qu'avec ton accord, et seulement si elle est signée par Kelid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All'avvio e ogni 24 ore, Kelid legge l'ultima versione pubblicata su GitHub. La richiesta non contiene alcun identificativo. Un aggiornamento si installa solo con il tuo consenso, e solo se è firmato da Kelid."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kelid는 실행 시와 이후 24시간마다 GitHub에 게시된 최신 버전을 확인해요. 요청에는 식별자가 포함되지 않아요. 업데이트는 사용자가 동의하고 Kelid가 서명한 경우에만 설치돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kelid 会在启动时及之后每隔 24 小时检查 GitHub 上发布的最新版本。请求不包含任何标识符。更新仅在你同意且经 Kelid 签名后才会安装。"
          }
        }
      }
    },
