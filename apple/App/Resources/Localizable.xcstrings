    "root.accountDeviceKnewNo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der diesem Gerät bekannte Account ist nicht mehr im lokalen Speicher vorhanden. Kelid erstellt niemals einen neuen Account darüber: Ein manipulierter Speicher könnte sonst dazu führen, dass du den Zugriff auf deinen Tresor verlierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account this device knew is no longer in its local storage. Kelid never creates a new account on top of it, because tampered storage could otherwise lock you out of your vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta que conocía este dispositivo ya no está en su almacenamiento local. Kelid nunca crea una cuenta nueva encima, porque un almacenamiento manipulado podría dejarte sin acceso a tu bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte que cet appareil connaissait n'est plus dans son stockage local. Kelid ne crée jamais un nouveau compte par-dessus : un stockage modifié pourrait sinon te faire perdre l'accès à ton coffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account che questo dispositivo conosceva non è più nella sua memoria locale. Kelid non crea mai un nuovo account sopra, perché una memoria manomessa potrebbe farti perdere l'accesso alla tua cassaforte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기에 저장되어 있던 계정이 로컬 저장 공간에 없어요. Kelid는 기존 계정 위에 새 계정을 만들지 않아요. 저장 공간이 변조된 경우 보관함에 접근하지 못하게 될 수 있기 때문이에요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此设备原有的账户已不在本地存储中。Kelid 绝不会覆盖创建新账户，因为存储内容若被篡改，可能导致你无法访问保险库。"
          }
        }
      }
    },
