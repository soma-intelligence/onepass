    "settings.deviceNowSignedIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Gerät ist jetzt bei einem anderen iCloud-Account angemeldet als dem, mit dem dein Tresor synchronisiert wurde. Zur Sicherheit liest Kelid keine Daten mehr aus iCloud und sendet auch keine dorthin. Dein Tresor bleibt auf diesem Gerät unverändert. Melde dich in den Einstellungen wieder beim ursprünglichen iCloud-Account an, um die Synchronisierung fortzusetzen, oder verwende diesen Account: Kelid prüft zuerst, ob er einen anderen Tresor enthält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device is now signed in to a different iCloud account than the one your vault synced with. To keep you safe, Kelid no longer reads from or sends anything to iCloud, and your vault stays intact on this device. Sign back in to the original iCloud account in Settings to resume syncing, or use this account: Kelid first checks that it doesn't hold another vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene ahora una sesión en una cuenta de iCloud distinta de la que sincronizaba tu bóveda. Por seguridad, Kelid ya no lee ni envía nada a iCloud, y tu bóveda sigue intacta en este dispositivo. Vuelve a iniciar sesión en la cuenta de iCloud original en Ajustes para reanudar la sincronización, o usa esta cuenta: Kelid comprueba antes que no contenga otra bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil est maintenant connecté à un autre compte iCloud que celui avec lequel ton coffre se synchronisait. Par sécurité, Kelid ne lit et n'envoie plus rien vers iCloud : ton coffre reste intact sur cet appareil. Reconnecte-toi au compte iCloud d'origine dans Réglages pour reprendre la synchronisation, ou utilise ce compte : Kelid vérifie d'abord qu'il ne contient pas un autre coffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo ora è connesso a un account iCloud diverso da quello con cui si sincronizzava la tua cassaforte. Per sicurezza, Kelid non legge né invia più nulla a iCloud e la tua cassaforte resta intatta su questo dispositivo. Accedi di nuovo all'account iCloud originale in Impostazioni per riprendere la sincronizzazione, oppure usa questo account: Kelid verifica prima che non contenga un'altra cassaforte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기는 보관함을 동기화하던 iCloud 계정과 다른 계정에 로그인되어 있어요. 안전을 위해 Kelid는 더 이상 iCloud에서 데이터를 읽거나 보내지 않아요. 보관함은 이 기기에 그대로 유지돼요. 동기화를 재개하려면 설정에서 원래 iCloud 계정으로 다시 로그인하거나 현재 계정을 사용해요. 현재 계정을 사용하면 Kelid가 먼저 다른 보관함이 있는지 확인해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此设备当前登录的 iCloud 账户与之前同步保险库的账户不同。为确保安全，Kelid 已停止从 iCloud 读取或向其发送任何内容，此设备上的保险库保持完整。要恢复同步，请在“设置”中重新登录原来的 iCloud 账户。你也可以使用当前账户，Kelid 会先检查其中是否有其他保险库。"
          }
        }
      }
    },
    "settings.devices.ack.footer" : {
      "comment" : "Réglages > Appareils: list footer line shown after a key rotation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seit dem letzten Schlüsselwechsel: „Aktuell“, wenn das Gerät die neuen Schlüssel bestätigt hat, andernfalls „Ausstehend“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since the last key change: “Up to Date” if the device confirmed the new keys, “Pending” otherwise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde el último cambio de claves: «Al día» si el dispositivo confirmó las nuevas claves, «Pendiente» si no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis le dernier changement de clés : « À jour » si l'appareil a confirmé les nouvelles clés, « En attente » sinon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dall'ultimo cambio delle chiavi: «Aggiornato» se il dispositivo ha confermato le nuove chiavi, «In attesa» altrimenti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "마지막 키 변경 후 기기가 새 키를 확인했으면 ‘최신 상태’, 아직 확인하지 않았으면 ‘대기 중’으로 표시돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自上次密钥更改以来，设备若已确认新密钥，则显示“已更新”，否则显示“待处理”。"
          }
        }
      }
    },
