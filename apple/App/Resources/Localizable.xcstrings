    "accounts.detail.domains.footer" : {
      "comment" : "Account settings: footer of the work domains.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auf diesen Websites und ihren Subdomains schlägt „Automatisch ausfüllen“ die Objekte dieses Kontos vor. Auf anderen Websites werden die Objekte des Hauptkontos vorgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On these sites and their subdomains, AutoFill offers this account's items. Elsewhere it offers the main account's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En estos sitios y sus subdominios, el autorrelleno ofrece los elementos de esta cuenta. En los demás, los de la cuenta principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur ces sites et leurs sous-domaines, le remplissage automatique propose les éléments de ce compte. Ailleurs, il propose ceux du compte principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questi siti e i loro sottodomini, il riempimento automatico propone gli elementi di questo account. Altrove propone quelli dell'account principale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 사이트와 하위 도메인에서는 자동 완성이 이 계정의 항목을 제안해요. 다른 사이트에서는 기본 계정의 항목을 제안해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在这些网站及其子域名上，自动填充会提供此账户中的项目。在其他网站上，则提供主账户中的项目。"
          }
