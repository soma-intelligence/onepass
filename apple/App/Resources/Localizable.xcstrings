    "root.changesMadeOnDevice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes made on this device and not yet sent to iCloud will be lost unless they were exported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios hechos en este dispositivo y aún no enviados a iCloud se perderán si no se han exportado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les changements faits sur cet appareil et pas encore envoyés à iCloud seront perdus s'ils n'ont pas été exportés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche fatte su questo dispositivo e non ancora inviate a iCloud andranno perse se non sono state esportate."
          }
        }
      }
    },
    "root.chooseLongPassphraseDont" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a long passphrase you don't use anywhere else, several words for example. OnePass refuses a passphrase that is too easy to guess."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una frase larga que no uses en ningún otro sitio, por ejemplo varias palabras. OnePass rechaza una frase demasiado fácil de adivinar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis une phrase longue que tu n'utilises nulle part ailleurs, par exemple plusieurs mots. OnePass refuse une phrase trop facile à deviner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una frase lunga che non usi altrove, per esempio più parole. OnePass rifiuta una frase troppo facile da indovinare."
          }
        }
      }
    },
