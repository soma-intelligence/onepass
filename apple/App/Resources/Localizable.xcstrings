    "crypto.item.derive.body" : {
      "comment" : "Confirmation body before deriving",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Phrase wird auf diesem Gerät im Arbeitsspeicher gelesen und danach daraus gelöscht. Nur die Bitcoin-xpub und die Ethereum- und Solana-Adressen werden zum Objekt hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phrase is read in memory on this device, then wiped. Only the Bitcoin xpub and the Ethereum and Solana addresses are added to the item."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frase se lee en memoria en este dispositivo y luego se borra. Solo se añaden al elemento la xpub de Bitcoin y las direcciones de Ethereum y Solana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La phrase est lue en mémoire sur cet appareil, puis effacée. Seules la xpub Bitcoin et les adresses Ethereum et Solana sont ajoutées à l'élément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frase viene letta in memoria su questo dispositivo, poi cancellata. All'elemento vengono aggiunti solo la xpub Bitcoin e gli indirizzi Ethereum e Solana."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기의 메모리에서 문구를 읽은 뒤 지워요. Bitcoin xpub와 Ethereum 및 Solana 주소만 항목에 추가해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "恢复短语会读取到此设备的内存中，随后被清除。只有比特币 xpub、以太坊和 Solana 地址会添加到项目中。"
