          }
        }
      }
    },
    "Importer depuis un autre gestionnaire…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import from Another Password Manager…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar desde otro gestor de contraseñas…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa da un altro gestore di password…"
          }
        }
      }
    },
    "Importer…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import…"
          }
        },
        "es" : {
