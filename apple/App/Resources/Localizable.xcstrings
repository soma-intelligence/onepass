    "onboarding.intro.yourkey.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du brauchst kein Konto bei uns. Dein Tresor wird auf deinem Gerät verschlüsselt. Selbst wir können ihn nicht öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account with us. Your vault is encrypted on your device, and even we can't open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta con nosotros. Tu bóveda se cifra en tu dispositivo, y ni siquiera nosotros podemos abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte chez nous. Ton coffre est chiffré sur ton appareil, et même nous ne pouvons pas l'ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account da noi. La tua cassaforte è cifrata sul tuo dispositivo, e nemmeno noi possiamo aprirla."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kelid 계정은 필요 없어요. 보관함은 기기에서 암호화되며, 저희도 열 수 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无需向我们注册账户。你的保险库在设备上加密，连我们也无法打开。"
          }
        }
      }
    },
    "onboarding.intro.yourkey.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur du hast den Schlüssel"
          }
        },
        "en" : {
          "stringUnit" : {
