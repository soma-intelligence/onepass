    "accounts.detail.remove.footer" : {
      "comment" : "Account settings: footer of the remove button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Konto bleibt in iCloud und auf deinen anderen Geräten. Du kannst es mit seinem Emergency Kit erneut hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account stays in iCloud and on your other devices. You can add it again with its Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta sigue en iCloud y en tus otros dispositivos. Puedes volver a añadirla con su Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte reste dans iCloud et sur tes autres appareils. Tu pourras le rajouter avec son Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account resta in iCloud e sui tuoi altri dispositivi. Puoi aggiungerlo di nuovo con il suo Emergency Kit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "계정은 iCloud와 다른 기기에 그대로 남아 있어요. Emergency Kit으로 다시 추가할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此账户仍会保留在 iCloud 和你的其他设备上。你可以使用其 Emergency Kit 重新添加。"
          }
        }
      }
    },
    "accounts.detail.remove.message" : {
      "comment" : "Confirmation message before an account leaves this device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Objekte, der Secret Key und die Einstellungen dieses Kontos werden von diesem Gerät entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its items, Secret Key and settings leave this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus elementos, su Secret Key y sus ajustes salen de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses éléments, sa Secret Key et ses réglages quittent cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi elementi, la sua Secret Key e le sue impostazioni lasciano questo dispositivo."
          }
        },
