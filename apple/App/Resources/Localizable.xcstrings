    "onboarding.kitPlusMasterPassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Kit und dein Master-Passwort ermöglichen vollen Zugriff auf deinen Tresor. Drucke es aus und bewahre das Blatt offline auf. Fotografiere es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This kit plus your master password give full access to your vault. Print it and keep the sheet offline; never take a photo of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este kit y tu contraseña maestra dan acceso completo a tu bóveda. Imprímelo y guarda la hoja sin conexión; nunca le hagas una foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce kit plus ton mot de passe maître donnent un accès complet à ton coffre. Imprime-le et range la feuille hors ligne ; ne le photographie pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo kit e la tua password principale danno accesso completo alla tua cassaforte. Stampalo e conserva il foglio offline; non fotografarlo mai."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 키트와 마스터 암호가 있으면 보관함에 완전히 접근할 수 있어요. 인쇄해서 종이로 보관하고, 사진은 찍지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "凭此 Emergency Kit 和你的主密码，即可完全访问你的保险库。请将它打印出来并离线保管，不要拍照。"
          }
        }
      }
    },
