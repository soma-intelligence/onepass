        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone cancella la sua chiave e %@ cancella la propria. Per riattivarlo, ricomincia dal Mac."
          }
        }
      }
    },
    "Cette commande ajoute seulement l'entrée « onepass » à la configuration de ton client et garde une copie de sauvegarde." : {
      "localizations" : {
        "en" : {
