    "Appareil de la famille ou du bureau : pas de %@, verrouillage après 5 minutes, coffres visibles au choix." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A family or work device: no %@, locks after 5 minutes, you choose which vaults are visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo familiar o del trabajo: sin %@, se bloquea tras 5 minutos y eliges qué bóvedas se ven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo di famiglia o di lavoro: niente %@, si blocca dopo 5 minuti e scegli quali casseforti sono visibili."
          }
        }
      }
    },
