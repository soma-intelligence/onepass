    "onboarding.typeSecretKeyPrinted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gib die Secret Key ein, die auf deinem Kit steht. Kleinbuchstaben, Leerzeichen und fehlende Bindestriche sind kein Problem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the Secret Key printed on your kit. Lowercase letters, spaces and missing dashes are fine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe la Secret Key impresa en tu kit. Se aceptan minúsculas, espacios y guiones olvidados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tape la Secret Key imprimée sur ton kit. Minuscules, espaces et tirets oubliés sont acceptés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita la Secret Key stampata sul tuo kit. Minuscole, spazi e trattini dimenticati sono accettati."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "키트에 인쇄된 Secret Key를 입력해 주세요. 소문자나 공백을 사용하거나 하이픈을 생략해도 괜찮아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "输入你的 Emergency Kit 上印有的 Secret Key。可使用小写字母，也可包含空格或省略连字符。"
          }
        }
      }
    },
    "onboarding.unlockKeyStaysIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Schlüssel zum Entsperren bleibt in der Secure Enclave dieses Mac. Wenn du einen Fingerabdruck hinzufügst, wird er ungültig. Dein Master-Passwort wird dann erneut abgefragt, außerdem alle 14 Tage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The unlock key stays in this Mac's Secure Enclave. Adding a fingerprint invalidates it, and your master password is asked for again. It's also asked for every 14 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de desbloqueo se queda en el Secure Enclave de este Mac. Añadir una huella la invalida y se vuelve a pedir la contraseña maestra. También se pide cada 14 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de déverrouillage reste dans la Secure Enclave de ce Mac. Ajouter une empreinte l'invalide : le mot de passe maître est alors redemandé. Il est aussi redemandé tous les 14 jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave di sblocco resta nel Secure Enclave di questo Mac. Aggiungere un'impronta la invalida e la password principale viene richiesta di nuovo. Viene richiesta anche ogni 14 giorni."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "잠금 해제 키는 이 Mac의 Secure Enclave에 보관돼요. 지문을 추가하면 키가 무효화되어 마스터 암호를 다시 입력해야 해요. 14일마다 마스터 암호를 다시 입력해야 해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "解锁密钥保存在这台 Mac 的安全隔区中。添加指纹会使其失效，届时需重新输入主密码。每 14 天也需重新输入一次。"
          }
        }
      }
    },
