    },
    "%@ est désactivé sur cet appareil, OnePass se verrouille après 5 minutes au plus et le mot de passe maître est demandé à chaque déverrouillage. Tu choisis ensuite les coffres visibles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is turned off on this device. OnePass locks after 5 minutes at most and asks for your master password every time you unlock. Next, you choose which vaults are visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está desactivado en este dispositivo: OnePass se bloquea tras 5 minutos como máximo y pide la contraseña maestra en cada desbloqueo. Después eliges qué bóvedas se ven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è disattivato su questo dispositivo: OnePass si blocca dopo 5 minuti al massimo e chiede la password principale a ogni sblocco. Poi scegli quali casseforti sono visibili."
          }
        }
      }
    },
    "%@ est retiré" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is removed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha quitado"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato rimosso"
          }
        }
      }
    },
    "%@ n'a pas été confirmé : rien n'a été activé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wasn't confirmed, so nothing was turned on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ha confirmado: no se ha activado nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è stato confermato: non è stato attivato nulla."
          }
        }
      }
    },
    "%@ n'est pas disponible sur cet appareil (pas de Secure Enclave ou biométrie non configurée). Le mot de passe maître déverrouille OnePass." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't available on this device (no Secure Enclave, or biometrics aren't set up). Your master password unlocks OnePass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible en este dispositivo (sin Secure Enclave o biometría sin configurar). La contraseña maestra desbloquea OnePass."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è disponibile su questo dispositivo (niente Secure Enclave o biometria non configurata). La password principale sblocca OnePass."
          }
        }
      }
    },
    "%@ n'est pas proposé sur un appareil partagé : le mot de passe maître est demandé à chaque déverrouillage." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't offered on a shared device. Your master password is required every time you unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ofrece en un dispositivo compartido: la contraseña maestra se pide en cada desbloqueo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è disponibile su un dispositivo condiviso: la password principale viene chiesta a ogni sblocco."
          }
        }
      }
    },
