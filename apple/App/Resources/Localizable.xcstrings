        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo .onepass: una copia de seguridad cifrada de esta cuenta, o la copia de otra cuenta con su frase de contraseña. No se sustituye nada de lo que ya hay en OnePass."
          }
        },
        "it" : {
          "stringUnit" : {
