    "settings.secretKeyDoesntChange" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Secret Key ändert sich nicht: Dein Emergency Kit bleibt gültig. Deine anderen Geräte fragen nach dem neuen Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Secret Key doesn't change: your Emergency Kit stays valid. Your other devices will ask for the new password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Secret Key no cambia: tu Emergency Kit sigue siendo válido. Tus otros dispositivos te pedirán la contraseña nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta Secret Key ne change pas : ton Emergency Kit reste valable. Tes autres appareils te demanderont le nouveau mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Secret Key non cambia: il tuo Emergency Kit resta valido. Gli altri dispositivi ti chiederanno la nuova password."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Secret Key는 바뀌지 않아 Emergency Kit는 계속 유효해요. 다른 기기에서는 새 암호를 요청해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 Secret Key 不会改变：你的 Emergency Kit 仍然有效。你的其他设备会要求输入新密码。"
          }
        }
      }
    },
    "settings.security.autofillReuse" : {
      "comment" : "Réglages > Sécurité: toggle, keep the AutoFill provider unlocked 90 seconds for the same site or app",
