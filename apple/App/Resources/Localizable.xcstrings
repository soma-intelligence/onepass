    "settings.autofill.history.footer" : {
      "comment" : "Réglages > Remplissage: autofill history footer (privacy)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass remembers which account you pick on each site, in which browser and profile, to offer it first. This history stays encrypted on this device: it is never synced or sent. Turned off, it is erased."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass recuerda qué cuenta eliges en cada sitio, en qué navegador y perfil, para ofrecerla primero. Este historial queda cifrado en este dispositivo: nunca se sincroniza ni se envía. Al desactivarlo, se borra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass retient quel compte vous choisissez sur chaque site, dans quel navigateur et quel profil, pour le proposer en premier. Cet historique reste chiffré sur cet appareil : il n'est jamais synchronisé ni envoyé. Désactivé, il est effacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass ricorda quale account scegli su ogni sito, in quale browser e profilo, per proporlo per primo. Questa cronologia resta cifrata su questo dispositivo: non viene mai sincronizzata né inviata. Disattivata, viene cancellata."
          }
        }
      }
    },
