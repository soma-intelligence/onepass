    "onboarding.fileCanLeaveDevice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file can leave this device without you noticing: iCloud Drive, Photos, messaging apps and screenshots sync the Secret Key elsewhere. Prefer printing, or save to a USB drive you keep offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo puede salir de este dispositivo sin que te des cuenta: iCloud Drive, Fotos, las apps de mensajería y las capturas de pantalla sincronizan la Secret Key en otros sitios. Mejor imprímela, o guárdala en una memoria USB que tengas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier peut quitter cet appareil sans que tu le voies : iCloud Drive, Photos, les messageries et les captures d'écran synchronisent la Secret Key ailleurs. Préfère l'impression, ou enregistre sur une clé USB que tu ranges hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file può lasciare questo dispositivo senza che tu te ne accorga: iCloud Drive, Foto, le app di messaggistica e gli screenshot sincronizzano la Secret Key altrove. Meglio stamparla, o salvarla su una chiavetta USB conservata offline."
          }
        }
      }
    },
    "onboarding.fileWillCopiedTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file will be copied to this service's servers and to your other devices. Together with your master password, it gives full access to your vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se copiará en los servidores de este servicio y en tus otros dispositivos. Junto con tu contraseña maestra, da acceso completo a tu bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier sera copié sur les serveurs de ce service et sur tes autres appareils. Avec ton mot de passe maître, il donne un accès complet à ton coffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file verrà copiato sui server di questo servizio e sugli altri tuoi dispositivi. Insieme alla password principale, dà accesso completo alla tua cassaforte."
          }
        }
      }
    },
