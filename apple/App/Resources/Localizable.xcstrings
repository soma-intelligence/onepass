            "value" : "Choose the program to pair with the OnePass MCP server."
          }
        }
      }
    },
    "Choisis ton fichier known_hosts (souvent ~/.ssh/known_hosts). OnePass le lit seulement." : {
      "localizations" : {
        "en" : {
