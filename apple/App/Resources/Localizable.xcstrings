    "developer.agentWebFillFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach deiner Zustimmung kann ein Agent Objekte aus diesem Tresor in eine Webseite eintragen. Die Seite erhält die Werte. Ein Agent, der Skripte auf der Seite ausführen kann, kann sie daher lesen. Aktiviere auch „Webformulare ausfüllen“ im Menü des gekoppelten Clients."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An agent can fill items from this vault into a web page once you approve. The page receives the values, so an agent that can run script in the page can read them. Then also tick \"Web fill\" in the paired client's menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente podrá rellenar elementos de esta bóveda en una página web tras tu aprobación. La página recibe los valores: un agente que puede ejecutar scripts en la página puede leerlos. Después marca también \"Relleno web\" en el menú del cliente emparejado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent pourra remplir ce coffre dans une page web après ton accord. La page reçoit les valeurs : un agent qui peut lancer du script dans la page peut les lire. Coche aussi « Remplissage web » dans le menu du client appairé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente potrà compilare elementi di questa cassaforte in una pagina web dopo la tua approvazione. La pagina riceve i valori: un agente che può eseguire script nella pagina può leggerli. Poi spunta anche \"Compilazione web\" nel menu del client abbinato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "승인하면 에이전트가 이 보관함의 항목으로 웹 페이지를 채울 수 있어요. 값이 웹 페이지에 전달되므로, 페이지에서 스크립트를 실행할 수 있는 에이전트는 이 값을 읽을 수 있어요. 페어링된 클라이언트 메뉴에서도 ‘웹 채우기’를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "经你批准后，智能体可以将此保险库中的项目填充到网页中。网页会接收填充的值，因此能在网页中运行脚本的智能体也能读取这些值。还需在已配对客户端的菜单中勾选“网页填充”。"
          }
        }
      }
    },
