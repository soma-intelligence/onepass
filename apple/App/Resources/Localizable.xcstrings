    "Conseil : quatre mots au hasard (« ruisseau-tapis-orage-comète ») sont plus solides et plus faciles à retenir qu'un mot compliqué." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tipp: Vier zufällige Wörter („Bach-Teppich-Gewitter-Komet“) sind sicherer und leichter zu merken als ein kompliziertes Wort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
