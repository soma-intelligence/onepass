    "Créée sur cet %@, elle ne le quitte jamais. Il te la faudra pour un nouvel appareil si aucun autre n'est à côté." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie wurde auf diesem %@ erstellt und verlässt es nie. Du brauchst sie, um ein neues Gerät einzurichten, wenn kein anderes Gerät in der Nähe ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was created on this %@ and never leaves it. You'll need it to set up a new device if no other device is nearby."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se creó en este %@ y nunca sale de él. La necesitarás para configurar un dispositivo nuevo si no tienes otro cerca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stata creata su questo %@ e non lo lascia mai. Ti servirà per configurare un nuovo dispositivo se non ne hai un altro vicino."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 %@에서 생성되어 이 기기를 벗어나지 않아요. 주변에 다른 기기가 없으면 새 기기를 설정할 때 필요해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它在这台 %@ 上创建，且从不离开此设备。附近没有其他设备时，你需要用它来设置新设备。"
          }
        }
      }
    },
