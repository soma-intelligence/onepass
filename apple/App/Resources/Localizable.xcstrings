    "safari.setup.ios.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari teilt Kelid nicht mit, ob die Erweiterung aktiv ist. Diese Karte verschwindet, sobald die Erweiterung auf diesem Gerät einmal geantwortet hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari does not tell Kelid whether the extension is on. This card goes away once the extension has answered on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari no le dice a Kelid si la extensión está activa. Esta tarjeta desaparece en cuanto la extensión responde una vez en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari ne dit pas à Kelid si l'extension est active. Cette carte part dès que l'extension a répondu une fois sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari non dice a Kelid se l'estensione è attiva. Questa scheda sparisce appena l'estensione risponde una volta su questo dispositivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari는 확장 프로그램이 켜져 있는지 Kelid에 알려주지 않아요. 이 기기에서 확장 프로그램이 한 번 응답하면 이 카드가 사라져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari 不会告知 Kelid 扩展是否已启用。扩展在此设备上响应一次后，此卡片就会消失。"
          }
        }
      }
    },
