    "org.tofu.warning" : {
      "comment" : "Join an organisation: asks to compare the fingerprint words with an administrator.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Überprüfe die Wörter mit deinem Administrator: Lies sie vor und stelle sicher, dass ihr dieselben Wörter seht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify with your administrator: read these words to them and check they see the same ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
