          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda en este dispositivo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta su questo dispositivo"
          }
        }
      }
    },
    "Elles remplissent depuis le coffre ouvert sur ce Mac et se verrouillent avec lui." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They fill from the vault open on this Mac and lock with it."
