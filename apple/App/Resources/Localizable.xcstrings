          }
        }
      }
    },
    "Tous les coffres redeviennent visibles. %@ reste désactivé jusqu'à ce que tu le réactives avec ton mot de passe maître." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All vaults become visible again. %@ stays off until you turn it back on with your master password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las bóvedas vuelven a ser visibles. %@ sigue desactivado hasta que lo vuelvas a activar con tu contraseña maestra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le casseforti tornano visibili. %@ resta disattivato finché non lo riattivi con la password principale."
