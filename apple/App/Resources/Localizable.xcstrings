    "developer.lockedUnlockItFor %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist gesperrt. Für Agenten entsperren und diese Anfrage erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is locked. Unlock it for the agents and allow this request?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está bloqueado. ¿Desbloquearlo para los agentes y permitir esta solicitud?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est verrouillé. Déverrouiller pour les agents et autoriser cette demande ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è bloccato. Sbloccarlo per gli agenti e consentire questa richiesta?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@이 잠겨 있어요. 에이전트용으로 잠금을 해제하고 이 요청을 허용할까요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已锁定。要为智能体解锁并允许此请求吗？"
          }
        }
      }
    },
    "developer.logNoLongerVerifies %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Protokoll lässt sich nicht mehr verifizieren (%@). Archiviere es, um ein neues zu beginnen. Das alte bleibt zur Prüfung daneben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The log no longer verifies (%@). Archive it to start a new one: the old one stays next to it for review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro ya no se verifica (%@). Archívalo para empezar uno nuevo: el antiguo se queda al lado para revisarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal ne se vérifie plus (%@). Archive-le pour en commencer un nouveau : l'ancien reste à côté pour examen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il registro non si verifica più (%@). Archivialo per iniziarne uno nuovo: il vecchio resta accanto per essere esaminato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로그를 더 이상 검증할 수 없어요(%@). 새 로그를 시작하려면 기존 로그를 보관하세요. 기존 로그는 검토할 수 있도록 함께 유지돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "日志无法再通过验证（%@）。将其归档以开始新日志，旧日志会保留在旁边以供检查。"
          }
        }
      }
    },
