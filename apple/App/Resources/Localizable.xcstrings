    "item.onceSaveWontAble" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach dem Sichern kannst du dich mit diesem Passkey nicht mehr bei dieser Website anmelden. Die Website behält ihn in deinem Account. Lösche ihn daher auch in den Einstellungen der Website."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you save, you won't be able to sign in to this site with this passkey. The site still keeps it in your account, so delete it in the site's settings too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar, ya no podrás iniciar sesión en este sitio con esta llave de acceso. El sitio la conserva en tu cuenta: elimínala también en sus ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l'enregistrement, tu ne pourras plus te connecter à ce site avec cette passkey. Le site la garde dans ton compte : supprime-la aussi dans ses réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo il salvataggio non potrai più accedere a questo sito con questa passkey. Il sito la conserva nel tuo account: eliminala anche nelle sue impostazioni."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "저장하면 이 패스키로 이 사이트에 로그인할 수 없어요. 사이트의 계정에는 패스키가 남아 있으니 사이트 설정에서도 삭제하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "存储后，你将无法再使用此通行密钥登录这个网站。网站仍会在你的账户中保留它，请同时在网站设置中将其删除。"
          }
        }
      }
    },
