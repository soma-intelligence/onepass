    "Oublier un site efface le compte retenu pour lui dans tous tes coffres visibles, sur tous tes appareils. Tes Logins ne changent pas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgetting a site erases the account remembered for it in all your visible vaults, on all your devices. Your Logins don't change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidar un sitio borra la cuenta recordada para él en todas tus bóvedas visibles, en todos tus dispositivos. Tus inicios de sesión no cambian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimenticare un sito cancella l'account memorizzato per esso in tutte le tue casseforti visibili, su tutti i tuoi dispositivi. I tuoi login non cambiano."
          }
        }
      }
    },
