    "Mots de passe, cartes, identités, notes : tout ce que tu ranges ici est chiffré sur tes appareils." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords, cards, identities, notes: everything you keep here is encrypted on your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraseñas, tarjetas, identidades, notas: todo lo que guardas aquí se cifra en tus dispositivos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password, carte, identità, note: tutto ciò che conservi qui è cifrato sui tuoi dispositivi."
          }
        }
      }
    },
