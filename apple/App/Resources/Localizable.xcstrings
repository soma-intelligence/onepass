    "%@ est activé" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist aktiviert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Is On"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está activado"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è attivo"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 기능이 켜져 있어요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已开启"
          }
        }
      }
    },
    "%@ est désactivé sur cet appareil, Kelid se verrouille après 5 minutes au plus et le mot de passe maître est demandé à chaque déverrouillage. Tu choisis ensuite les coffres visibles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist auf diesem Gerät deaktiviert. Kelid wird spätestens nach 5 Minuten gesperrt und fragt bei jedem Entsperren nach deinem Master-Passwort. Danach wählst du die sichtbaren Tresore aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is turned off on this device. Kelid locks after 5 minutes at most and asks for your master password every time you unlock. Next, you choose which vaults are visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está desactivado en este dispositivo: Kelid se bloquea tras 5 minutos como máximo y pide la contraseña maestra en cada desbloqueo. Después eliges qué bóvedas se ven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è disattivato su questo dispositivo: Kelid si blocca dopo 5 minuti al massimo e chiede la password principale a ogni sblocco. Poi scegli quali casseforti sono visibili."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기에서는 %@ 기능이 꺼져 있어요. Kelid는 최대 5분 후에 잠기며, 잠금을 해제할 때마다 마스터 암호를 입력해야 해요. 다음으로 표시할 보관함을 선택해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此设备上已关闭 %@。Kelid 最迟会在 5 分钟后锁定，每次解锁都需要输入主密码。接下来，你可以选择要显示的保险库。"
          }
        }
      }
    },
    "%@ n'est pas disponible sur cet appareil (pas de Secure Enclave ou biométrie non configurée). Le mot de passe maître déverrouille Kelid." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist auf diesem Gerät nicht verfügbar (keine Secure Enclave oder Biometrie nicht eingerichtet). Mit deinem Master-Passwort kannst du Kelid entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't available on this device (no Secure Enclave, or biometrics aren't set up). Your master password unlocks Kelid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible en este dispositivo (sin Secure Enclave o biometría sin configurar). La contraseña maestra desbloquea Kelid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è disponibile su questo dispositivo (niente Secure Enclave o biometria non configurata). La password principale sblocca Kelid."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기에서는 %@ 기능을 사용할 수 없어요(Secure Enclave가 없거나 생체 인식이 설정되지 않았어요). 마스터 암호로 Kelid 잠금을 해제할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此设备无法使用 %@（没有安全隔区或尚未设置生物识别）。你可以使用主密码解锁 Kelid。"
          }
        }
      }
    },
    "%@ n'est pas proposé sur un appareil partagé : le mot de passe maître est demandé à chaque déverrouillage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ wird auf einem gemeinsam genutzten Gerät nicht angeboten. Bei jedem Entsperren wird dein Master-Passwort benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn't offered on a shared device. Your master password is required every time you unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ofrece en un dispositivo compartido: la contraseña maestra se pide en cada desbloqueo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è disponibile su un dispositivo condiviso: la password principale viene chiesta a ogni sblocco."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "공유 기기에서는 %@ 기능을 사용할 수 없어요. 잠금을 해제할 때마다 마스터 암호를 입력해야 해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "共用设备不提供 %@，每次解锁都需要输入主密码。"
          }
        }
      }
    },
