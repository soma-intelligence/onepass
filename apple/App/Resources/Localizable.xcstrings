        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was created on this Mac and never leaves it. Together with your master password, it protects your vault even if iCloud were hacked. You'll need it to set up a new device when no other device is nearby."
          }
        }
      }
    },
