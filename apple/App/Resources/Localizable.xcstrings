    "EFFACER" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ERASE"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BORRAR"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CANCELLA"
          }
        }
      }
    },
    "Efface tout ce que la montre a reçu et coupe l'envoi. Réactive « Envoyer à l'Apple Watch » pour envoyer de nouveau." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erases everything the watch received and stops sending. Turn “Send to Apple Watch” back on to send again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra todo lo que recibió el reloj y deja de enviar. Vuelve a activar «Enviar al Apple Watch» para enviar de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella tutto ciò che l'orologio ha ricevuto e interrompe l'invio. Riattiva «Invia ad Apple Watch» per inviare di nuovo."
          }
        }
      }
    },
    "Effacer cet appareil" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase This Device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar este dispositivo"
          }
        },
        "it" : {
          "stringUnit" : {
