    "settings.passwordListPrintedTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine als PDF gedruckte Passwortliste oder das Emergency Kit von 1Password. Kelid liest den Text der PDF-Datei auf diesem Gerät und zeigt dir dann, was gefunden wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A password list printed to PDF, or a 1Password Emergency Kit. Kelid reads the PDF's text on this device, then shows you what it found."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lista de contraseñas impresa en PDF, o el Emergency Kit de 1Password. Kelid lee el texto del PDF en este dispositivo y luego te muestra lo que ha encontrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une liste de mots de passe imprimée en PDF, ou l'Emergency Kit de 1Password. Kelid lit le texte du PDF sur cet appareil, puis te montre ce qu'il a trouvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elenco di password stampato in PDF, o l'Emergency Kit di 1Password. Kelid legge il testo del PDF su questo dispositivo, poi ti mostra cosa ha trovato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF로 저장한 암호 목록이나 1Password의 Emergency Kit예요. Kelid가 이 기기에서 PDF의 텍스트를 읽고 찾은 내용을 보여줘요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打印为 PDF 的密码列表，或 1Password 的 Emergency Kit。Kelid 会在此设备上读取 PDF 中的文本，然后向你显示找到的内容。"
          }
        }
      }
    },
