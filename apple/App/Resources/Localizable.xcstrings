    "Ce PDF est illisible ou endommagé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PDF can't be read or is damaged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PDF no se puede leer o está dañado."
          }
        },
