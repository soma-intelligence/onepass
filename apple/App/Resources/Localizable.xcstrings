    "safari.setup.mac.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktiviere Kelid unter Safari > Einstellungen > Erweiterungen. Setze dann unter „Websites bearbeiten“ die Option „Beim Besuch anderer Websites“ auf „Erlauben“. Sonst fragt Safari für jede Website einzeln nach und Kelid kann die Felder nicht erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Safari > Settings > Extensions, check Kelid, then in Edit Websites set When visiting other websites to Allow. Otherwise Safari asks site by site and Kelid cannot see the fields."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Safari > Ajustes > Extensiones, marca Kelid y luego en Editar sitios web pon Al visitar otros sitios web en Permitir. Si no, Safari pregunta sitio por sitio y Kelid no ve los campos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Safari > Réglages > Extensions, coche Kelid, puis dans Modifier les sites web, mets Sur les autres sites web sur Autoriser. Sinon Safari demande site par site et Kelid ne voit pas les champs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Safari > Impostazioni > Estensioni, seleziona Kelid, poi in Modifica siti web imposta Quando visiti altri siti web su Consenti. Altrimenti Safari chiede sito per sito e Kelid non vede i campi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari > 설정 > 확장 프로그램에서 Kelid를 선택한 다음, ‘웹 사이트 편집’에서 ‘다른 웹 사이트 방문 시’를 ‘허용’으로 설정하세요. 그렇지 않으면 Safari가 사이트마다 권한을 요청하고 Kelid가 입력 필드를 확인할 수 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 Safari 浏览器 > 设置 > 扩展中勾选 Kelid，然后在“编辑网站”中，将“访问其他网站时”设为“允许”。否则，Safari 浏览器会逐个网站询问，Kelid 也无法读取表单栏位。"
          }
        }
      }
    },
