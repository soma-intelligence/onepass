    "settings.about.updates.footer" : {
      "comment" : "Réglages > À propos (Mac): footer of the updates section, what the check sends",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At launch and every 24 hours, OnePass reads the latest version published on GitHub. The request carries no identifier. An update installs only with your approval, and only if OnePass signed it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrirse y cada 24 horas, OnePass consulta la última versión publicada en GitHub. La solicitud no contiene ningún identificador. Una actualización solo se instala con tu permiso, y solo si OnePass la ha firmado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au lancement puis toutes les 24 heures, OnePass lit la dernière version publiée sur GitHub. La requête ne contient aucun identifiant. Une mise à jour ne s'installe qu'avec ton accord, et seulement si elle est signée par OnePass."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All'avvio e ogni 24 ore, OnePass legge l'ultima versione pubblicata su GitHub. La richiesta non contiene alcun identificativo. Un aggiornamento si installa solo con il tuo consenso, e solo se è firmato da OnePass."
          }
        }
      }
    },
