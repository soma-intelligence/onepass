        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada solicitud llega también a tu iPhone, y cuenta la primera respuesta. La ventana de los agentes se cierra al terminar, cuando este Mac entra en reposo o cuando bloqueas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
