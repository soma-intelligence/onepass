          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione è in pausa e la tua cassaforte resta intatta su questo dispositivo. Accedi di nuovo all'account originale, oppure usa questo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "동기화가 일시 정지됐어요. 보관함은 이 기기에 그대로 남아 있어요. 원래 계정으로 다시 로그인하거나 이 계정을 사용해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
