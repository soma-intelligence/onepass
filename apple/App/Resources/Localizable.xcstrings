    "onboarding.intro.everywhere.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles wird über deine iCloud synchronisiert und in Safari und deinen Apps automatisch ausgefüllt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
