        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svuota questa cassaforte prima di eliminarla. I suoi elementi in Eliminati di recente vengono eliminati con lei."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "삭제하기 전에 이 보관함을 비워 주세요. 최근 삭제된 항목에 있는 이 보관함의 항목도 함께 삭제돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
