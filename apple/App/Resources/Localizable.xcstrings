          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte è vuota"
          }
        }
      }
    },
    "Ton coffre s'ouvre maintenant d'un regard ou d'un doigt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault now opens with a glance or a touch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda ahora se abre con una mirada o un toque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte ora si apre con uno sguardo o un tocco."
          }
        }
      }
    },
    "Ton compte est arrivé sur cet appareil. Ton mot de passe maître l'ouvre, comme sur tes autres appareils." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is on this device. Your master password opens it, as on your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta ya está en este dispositivo. Tu contraseña maestra la abre, como en tus otros dispositivos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è arrivato su questo dispositivo. La password principale lo apre, come sugli altri dispositivi."
          }
        }
      }
    },
    "Ton mot de passe maître" : {
