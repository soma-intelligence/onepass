          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte è cifrata e pronta su questo %@."
          }
        }
      }
    },
    "Ton coffre est dans iCloud : il reviendrait sur cet appareil. Pour l'ouvrir, saisis la Secret Key de ton Emergency Kit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault is in iCloud and would come back to this device. To open it, enter the Secret Key from your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda está en iCloud y volvería a este dispositivo. Para abrirla, introduce la Secret Key de tu Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte è in iCloud e tornerebbe su questo dispositivo. Per aprirla, inserisci la Secret Key del tuo Emergency Kit."
          }
        }
      }
    },
    "Ton coffre est vide" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Vault Is Empty"
          }
        },
        "es" : {
