            "value" : "Cancella questo dispositivo"
          }
        }
      }
    },
    "Effacer les données OnePass de cet appareil ?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase the OnePass data on this device?"
          }
        },
        "es" : {
          "stringUnit" : {
