    },
    "Choisis OnePass comme app de codes de vérification : le code du Login du site est proposé dans le champ." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose OnePass as your verification code app, and the code from the site's Login is suggested in the field."
