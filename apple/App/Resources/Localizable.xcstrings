    },
    "Ton autre appareil est un Mac ? Ouvre le menu de ton compte, puis « Configurer un appareil »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your other device a Mac? Open your account menu, then “Set Up a Device”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tu otro dispositivo es un Mac? Abre el menú de tu cuenta y luego «Configurar un dispositivo»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo è un Mac? Apri il menu del tuo account, poi «Configura un dispositivo»."
          }
        }
      }
    },
    "Ton autre appareil le valide en scannant un QR code. Rien ne passe par un serveur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your other device approves it by scanning a QR code. Nothing goes through a server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu otro dispositivo lo aprueba escaneando un código QR. Nada pasa por un servidor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo lo approva scansionando un codice QR. Niente passa da un server."
          }
        }
      }
    },
    "Ton coffre chiffré sera envoyé dans ce compte iCloud." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your encrypted vault will be uploaded to this iCloud account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda cifrada se subirá a esta cuenta de iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte cifrata verrà caricata in questo account iCloud."
          }
        }
      }
    },
    "Ton coffre est chiffré et prêt sur cet %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault is encrypted and ready on this %@."
          }
        },
