    "settings.sync.migrate.explain" : {
      "comment" : "Migration sheet: what the move does.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein verschlüsselter Tresor wechselt von iCloud zum Kelid-Server. Deine anderen Apple-Geräte bieten dir an, ebenfalls zu wechseln. Die iCloud-Kopie bleibt erhalten, bis du sie löschst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your encrypted vault leaves iCloud for the Kelid Server. Your other Apple devices will offer to follow. The iCloud copy stays until you erase it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda cifrada deja iCloud y pasa al servidor de Kelid. Tus otros dispositivos Apple te propondrán seguirla. La copia de iCloud se queda hasta que la borres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton coffre chiffré quitte iCloud pour le serveur Kelid. Tes autres appareils Apple te proposeront de suivre. La copie iCloud reste en place jusqu'à ce que tu l'effaces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte cifrata lascia iCloud per il server Kelid. Gli altri tuoi dispositivi Apple ti proporranno di seguirla. La copia su iCloud resta finché non la cancelli."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "암호화된 보관함이 iCloud에서 Kelid 서버로 이동해요. 다른 Apple 기기에서도 이동 안내가 표시돼요. iCloud 사본은 직접 삭제할 때까지 유지돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的加密保险库将从 iCloud 迁移到 Kelid 服务器。你的其他 Apple 设备会提示你一同迁移。iCloud 副本会保留，直到你将其删除。"
          }
        }
      }
    },
