    "vaults.inTravelModeVaults" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Im Travel Mode werden Tresore, die nicht als reisesicher markiert sind, bis zu deiner Rückkehr von deinen Geräten entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Travel Mode, the vaults that are not safe for travel leave your devices until you come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Travel Mode, las bóvedas que no son seguras para viajar salen de tus dispositivos hasta tu vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Travel Mode, les coffres qui ne sont pas sûrs en voyage quittent tes appareils jusqu'à ton retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Travel Mode, le casseforti non sicure in viaggio lasciano i tuoi dispositivi fino al tuo ritorno."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Travel Mode에서는 여행에 안전하지 않은 보관함이 돌아올 때까지 기기에서 제거돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用 Travel Mode 时，不适合旅行的保险库会从你的设备上移除，直到你返回。"
          }
        }
      }
    },
