            "value" : "Sie kann dann nicht mehr ausfüllen. Kopple sie erneut, um sie wieder zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It won't be able to fill anymore. To use it again, pair it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no podrá rellenar. Para volver a usarla, enlázala de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potrà più compilare. Per usarla di nuovo, abbinala di nuovo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "더 이상 채우기를 사용할 수 없어요. 다시 사용하려면 다시 페어링해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它将无法再填充。要再次使用，请重新配对。"
