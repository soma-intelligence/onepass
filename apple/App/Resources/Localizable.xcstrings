    "%@ accepte les passkeys. Une passkey remplace ton mot de passe : plus rapide, et impossible à hameçonner." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supports passkeys. A passkey replaces your password: faster, and it can’t be phished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ admite llaves de acceso. Una llave de acceso sustituye a tu contraseña: más rápida e imposible de suplantar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supporta le passkey. Una passkey sostituisce la tua password: più veloce e impossibile da rubare con il phishing."
          }
        }
      }
    },
