    "item.alreadyHasOneTime %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ already has a one-time code. The new one replaces it, and the old one stays in the hidden “Previous code” field."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya tiene un código de un solo uso. El nuevo lo sustituye y el antiguo se queda en el campo oculto «Código anterior»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a déjà un code à usage unique. Le nouveau le remplace, l'ancien reste dans le champ masqué « Ancien code »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha già un codice monouso. Quello nuovo lo sostituisce e il vecchio resta nel campo nascosto «Codice precedente»."
          }
        }
      }
    },
