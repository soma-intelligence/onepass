    "root.encryptedOnepassArchiveOf" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein verschlüsseltes Kelid-Archiv mit allen Inhalten dieses Geräts, einschließlich Tresoren und Objekten in „Zuletzt gelöscht“. Du kannst es mit der hier gewählten Passphrase oder mit deinem Account öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An encrypted Kelid archive of everything this device holds, vaults and items in Recently Deleted included. It opens with the passphrase chosen here or with your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo cifrado de Kelid con todo lo que contiene este dispositivo, incluidas las bóvedas y los elementos en Eliminado. Se abre con la frase de contraseña elegida aquí o con tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une archive Kelid chiffrée de tout ce que cet appareil contient, coffres et éléments dans Supprimés récemment compris. Elle s'ouvre avec la phrase de passe choisie ici ou avec ton compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivio Kelid cifrato di tutto ciò che contiene questo dispositivo, casseforti ed elementi in Eliminati di recente compresi. Si apre con la passphrase scelta qui o con il tuo account."
          }
        },
        "ko" : {
