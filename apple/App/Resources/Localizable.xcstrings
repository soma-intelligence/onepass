        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "암호, 패스키, 카드 및 문서를 양자 컴퓨터에도 안전한 암호화 기술로 %@에서 암호화해요."
          }
        },
        "zh-Hans" : {
