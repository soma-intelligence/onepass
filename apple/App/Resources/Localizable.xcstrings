          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esci dal client prima di installare: riscrive la sua configurazione quando esce. Il file originale resta accanto (.onepass-bak)."
          }
        }
      }
    },
