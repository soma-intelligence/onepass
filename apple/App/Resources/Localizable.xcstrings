    },
    "Ton autre appareil le valide en scannant un QR code. Rien ne passe par un serveur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your other device approves it by scanning a QR code. Nothing goes through a server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu otro dispositivo lo aprueba escaneando un código QR. Nada pasa por un servidor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo lo approva scansionando un codice QR. Niente passa da un server."
          }
        }
      }
    },
    "Ton coffre est dans iCloud : il reviendrait sur cet appareil. Pour l'ouvrir, saisis la Secret Key de ton Emergency Kit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault is in iCloud and would come back to this device. To open it, enter the Secret Key from your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda está en iCloud y volvería a este dispositivo. Para abrirla, introduce la Secret Key de tu Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte è in iCloud e tornerebbe su questo dispositivo. Per aprirla, inserisci la Secret Key del tuo Emergency Kit."
          }
        }
      }
    },
    "Ton coffre s'ouvre maintenant d'un regard ou d'un doigt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault now opens with a glance or a touch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda ahora se abre con una mirada o un toque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua cassaforte ora si apre con uno sguardo o un tocco."
          }
        }
      }
    },
    "Ton compte est arrivé sur cet appareil. Ton mot de passe maître l'ouvre, comme sur tes autres appareils." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is on this device. Your master password opens it, as on your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta ya está en este dispositivo. Tu contraseña maestra la abre, como en tus otros dispositivos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è arrivato su questo dispositivo. La password principale lo apre, come sugli altri dispositivi."
          }
        }
      }
    },
    "Ton mot de passe maître" : {
      "localizations" : {
