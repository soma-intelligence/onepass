      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The OnePass extensions for Safari, Chrome, Edge, Brave and Firefox connect by themselves when the Mac checks the browser's signature, and fill from the vault open in this app. Locking OnePass locks them too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las extensiones de OnePass para Safari, Chrome, Edge, Brave y Firefox se conectan solas cuando el Mac verifica la firma del navegador, y rellenan desde la bóveda abierta en esta app. Bloquear OnePass también las bloquea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extensions OnePass de Safari, Chrome, Edge, Brave et Firefox se connectent seules quand le Mac vérifie la signature du navigateur, et remplissent depuis le coffre ouvert dans cette app. Verrouiller OnePass les verrouille aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estensioni OnePass per Safari, Chrome, Edge, Brave e Firefox si collegano da sole quando il Mac verifica la firma del browser, e compilano dalla cassaforte aperta in questa app. Bloccare OnePass blocca anche loro."
          }
        }
      }
    },
