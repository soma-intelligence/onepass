      }
    },
    "Tous les éléments" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Items"
          }
        }
      }
    },
    "Tous tes mots de passe, passkeys, cartes et documents, chiffrés avec une cryptographie qui résiste aux ordinateurs quantiques." : {
      "localizations" : {
        "en" : {
