    "settings.itemsKeepTheirIdentifier" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Objekte behalten ihre Kennung, auch archivierte Objekte und Objekte in „Zuletzt gelöscht“. Für deine anderen Geräte wird eine mit deinem Account signierte Wiederherstellung gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items keep their identifier, deleted and archived ones included. A restore signed by your account is recorded for your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos conservan su identificador, incluidos los eliminados y los archivados. Se registra una restauración firmada por tu cuenta para tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments gardent leur identifiant, ceux de Supprimés récemment et les archivés compris. Une restauration signée par ton compte est enregistrée pour tes autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi mantengono il loro identificativo, compresi quelli eliminati e archiviati. Viene registrato un ripristino firmato dal tuo account per gli altri dispositivi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "최근 삭제된 항목과 보관된 항목을 포함해 모든 항목의 식별자가 유지돼요. 다른 기기를 위해 계정으로 서명된 복원 기록이 저장돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "项目会保留其标识符，包括“最近删除”中的项目和已归档的项目。系统会记录一条由你的账户签名的恢复操作，供你的其他设备使用。"
          }
        }
      }
    },
