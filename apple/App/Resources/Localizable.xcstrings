    "settings.browsers.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Kelid-Erweiterungen für Safari, Chrome, Edge, Brave und Firefox verbinden sich automatisch, sobald der Mac die Signatur des Browsers überprüft. Sie füllen Felder mit Daten aus dem Tresor aus, der in dieser App geöffnet ist. Wenn du Kelid sperrst, werden auch die Erweiterungen gesperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Kelid extensions for Safari, Chrome, Edge, Brave and Firefox connect by themselves when the Mac checks the browser's signature, and fill from the vault open in this app. Locking Kelid locks them too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las extensiones de Kelid para Safari, Chrome, Edge, Brave y Firefox se conectan solas cuando el Mac verifica la firma del navegador, y rellenan desde la bóveda abierta en esta app. Bloquear Kelid también las bloquea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extensions Kelid de Safari, Chrome, Edge, Brave et Firefox se connectent seules quand le Mac vérifie la signature du navigateur, et remplissent depuis le coffre ouvert dans cette app. Verrouiller Kelid les verrouille aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estensioni Kelid per Safari, Chrome, Edge, Brave e Firefox si collegano da sole quando il Mac verifica la firma del browser, e compilano dalla cassaforte aperta in questa app. Bloccare Kelid blocca anche loro."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari, Chrome, Edge, Brave, Firefox의 Kelid 확장 프로그램은 Mac이 브라우저 서명을 확인하면 자동으로 연결되고, 이 앱에서 열린 보관함의 정보로 자동 완성해요. Kelid를 잠그면 확장 프로그램도 잠겨요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac 验证浏览器签名后，Safari、Chrome、Edge、Brave 和 Firefox 的 Kelid 扩展会自动连接，并使用此 App 中已打开的保险库进行填充。锁定 Kelid 也会锁定这些扩展。"
          }
        }
      }
    },
