      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass fills your logins, codes and passkeys in apps and Safari."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass rellena tus inicios de sesión, códigos y llaves de acceso en las apps y en Safari."
          }
        },
