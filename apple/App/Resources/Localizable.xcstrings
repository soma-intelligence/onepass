      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leere diesen Tresor, bevor du ihn löschst. Seine Objekte in „Zuletzt gelöscht“ werden ebenfalls gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty this vault before deleting it. Its items in Recently Deleted go with it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía esta bóveda antes de eliminarla. Sus elementos en Eliminado se van con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide ce coffre avant de le supprimer. Ses éléments dans Supprimés récemment partent avec lui."
