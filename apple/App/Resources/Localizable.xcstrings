        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er verschwindet von all deinen Geräten und erscheint mit seinen Objekten unter „Zuletzt gelöscht“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It disappears from all your devices, with its items in Recently Deleted."
