    "Sur l'iPhone ou l'iPad : « J'ai déjà OnePass sur un autre appareil », puis « Scanner le code de mon autre appareil »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the iPhone or iPad: “I Already Have OnePass on Another Device”, then “Scan My Other Device’s Code”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPhone o iPad: «Ya tengo OnePass en otro dispositivo» y luego «Escanear el código de mi otro dispositivo»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPhone o iPad: «Ho già OnePass su un altro dispositivo», poi «Scansiona il codice del mio altro dispositivo»."
          }
        }
      }
    },
    "Sur le nouvel appareil, choisis « J'ai déjà OnePass sur un autre appareil » : il affiche un QR code à scanner avec ton iPhone ou ton iPad." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the new device, choose \"I already have OnePass on another device\" : it shows a QR code to scan with your iPhone or iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el nuevo dispositivo, elige «Ya tengo OnePass en otro dispositivo»: muestra un código QR que escanear con tu iPhone o iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul nuovo dispositivo, scegli «Ho già OnePass su un altro dispositivo»: mostra un codice QR da scansionare con iPhone o iPad."
          }
        }
      }
    },
    "Sur le nouvel appareil, choisis « J'ai déjà OnePass sur un autre appareil » : il affiche un QR code à scanner d'ici." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the new device, choose \"I already have OnePass on another device\" : it shows a QR code to scan from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el nuevo dispositivo, elige «Ya tengo OnePass en otro dispositivo»: muestra un código QR que escanear desde aquí."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul nuovo dispositivo, scegli «Ho già OnePass su un altro dispositivo»: mostra un codice QR da scansionare da qui."
          }
        }
      }
    },
