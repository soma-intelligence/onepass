            "value" : "已共享"
          }
        }
      }
    },
    "Il est à toi : tout ton coffre, déverrouillage par %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es gehört dir: dein ganzer Tresor, entsperrt mit %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's yours: your whole vault, unlocked with %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tuyo: toda tu bóveda, desbloqueada con %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È tuo: tutta la tua cassaforte, sbloccata con %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "내 기기예요. %@로 전체 보관함의 잠금을 해제해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它属于你：包含你的整个保险库，可通过 %@ 解锁。"
          }
        }
      }
    },
    "Il recevra seulement les éléments que tu choisis, en lecture seule, pour un temps limité." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es erhält nur die von dir ausgewählten Objekte, schreibgeschützt und für begrenzte Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will only get the items you choose, read only, for a limited time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo recibirá los elementos que elijas, en solo lectura y por tiempo limitado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverà solo gli elementi che scegli, in sola lettura e per un tempo limitato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택한 항목만 제한된 시간 동안 읽기 전용으로 받아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它只会接收你选择的项目，且只能在限定时间内查看。"
          }
        }
      }
    },
    "Il recevra tout ton compte et ta Secret Key, puis te demandera ton mot de passe maître." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es erhält deinen gesamten Account und deinen Secret Key und fragt dann nach deinem Master-Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will get your whole account and your Secret Key, then ask for your master password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirá toda tu cuenta y tu Secret Key, y luego te pedirá tu contraseña maestra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverà tutto il tuo account e la tua Secret Key, poi ti chiederà la password principale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "계정 전체와 Secret Key를 받은 후 마스터 암호를 요청해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它会接收你的整个账户和 Secret Key，然后要求你输入主密码。"
          }
        }
      }
    },
    "Il recevra tout ton compte, sans Face ID, avec les coffres visibles au choix." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es erhält deinen gesamten Account, ohne Face ID. Du wählst, welche Tresore sichtbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will get your whole account, without Face ID, with the vaults you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirá toda tu cuenta, sin Face ID, con las bóvedas que elijas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverà tutto il tuo account, senza Face ID, con le casseforti che scegli."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "계정 전체를 받고 Face ID는 사용하지 않아요. 표시할 보관함을 선택할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它会接收你的整个账户，不使用面容 ID，你可以选择显示哪些保险库。"
          }
        }
      }
    },
