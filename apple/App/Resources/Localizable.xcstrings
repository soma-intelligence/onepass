    "settings.markStolen.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bei der nächsten Synchronisierung löscht dieses Gerät seine Kelid-Daten, ohne 7 Tage zu warten. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At its next sync, this device erases its Kelid data, with no 7-day wait. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En su próxima sincronización, este dispositivo borra sus datos de Kelid, sin esperar 7 días. No se puede deshacer."
          }
        },
        "fr" : {
