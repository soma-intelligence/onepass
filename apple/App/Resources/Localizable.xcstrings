    "accounts.settings.unifiedSearch.footer" : {
      "comment" : "Settings > Accounts: footer of the unified search toggle.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fügt „In allen Accounts suchen“ zum Accountmenü hinzu. Nur entsperrte Accounts werden durchsucht. Andernfalls zeigt jeder Account nur seine eigenen Objekte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds \"Search All Accounts\" to the account menu. Only unlocked accounts are searched. Otherwise each account shows only its own items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade «Buscar en todas las cuentas» al menú de la cuenta. Solo se buscan las cuentas desbloqueadas. Si no, cada cuenta muestra solo sus elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute « Rechercher dans tous les comptes » au menu du compte. Seuls les comptes déverrouillés sont cherchés. Sinon, chaque compte ne montre que ses éléments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge «Cerca in tutti gli account» al menu dell'account. Si cerca solo negli account sbloccati. Altrimenti ogni account mostra solo i suoi elementi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "계정 메뉴에 ‘모든 계정 검색’을 추가해요. 잠금 해제된 계정만 검색해요. 이 기능을 끄면 각 계정의 항목만 표시돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在账户菜单中添加“搜索所有账户”。仅搜索已解锁的账户。关闭后，每个账户仅显示自己的项目。"
          }
        }
      }
    },
