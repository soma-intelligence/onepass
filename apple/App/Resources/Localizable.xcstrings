    "accounts.detail.browsers.footer" : {
      "comment" : "Account settings (Mac): footer of the \"Available in browsers\" switch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solange dieses Konto entsperrt ist, können mit diesem Mac gekoppelte Browser seine Objekte zum Ausfüllen verwenden. Ist die Option deaktiviert, sehen sie nur das Hauptkonto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While this account is unlocked, the browsers paired with this Mac can fill its items. Off, they only see the main account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras esta cuenta esté desbloqueada, los navegadores asociados a este Mac pueden rellenar sus elementos. Desactivado, solo ven la cuenta principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que ce compte est déverrouillé, les navigateurs associés à ce Mac peuvent remplir ses éléments. Désactivé, ils ne voient que le compte principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché questo account è sbloccato, i browser associati a questo Mac possono compilare i suoi elementi. Se disattivato, vedono solo l'account principale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 계정의 잠금이 해제되어 있으면 이 Mac과 연결된 브라우저에서 계정의 항목을 채울 수 있어요. 끄면 기본 계정만 표시돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此账户解锁时，与这台 Mac 配对的浏览器可填充此账户中的项目。关闭后，浏览器只能访问主账户。"
          }
        }
      }
    },
