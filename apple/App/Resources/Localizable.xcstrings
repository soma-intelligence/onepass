    "Appareil partagé : le délai est imposé (5 minutes au plus). Repasse en mode personnel pour le régler." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geteiltes Gerät: Die Sperrzeit ist festgelegt (höchstens 5 Minuten). Wechsle zum persönlichen Modus, um sie zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared device: the timeout is fixed (5 minutes at most). Switch back to personal mode to change it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispositivo compartido: el tiempo está fijado (5 minutos como máximo). Vuelve al modo personal para cambiarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispositivo condiviso: il tempo è fisso (5 minuti al massimo). Torna alla modalità personale per modificarlo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "공유 기기는 잠금 시간이 최대 5분으로 고정돼요. 변경하려면 개인 모드로 전환해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "共享设备：锁定时间固定，最长为 5 分钟。切换回个人模式即可调整。"
          }
        }
      }
    },
