    "item.supportsPasskeysPasskeyReplaces %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ unterstützt Passkeys. Ein Passkey ersetzt dein Passwort: schneller und vor Phishing geschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supports passkeys. A passkey replaces your password: faster, and it can’t be phished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ admite llaves de acceso. Una llave de acceso sustituye a tu contraseña: más rápida e imposible de suplantar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ accepte les passkeys. Une passkey remplace ton mot de passe : plus rapide, et impossible à hameçonner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supporta le passkey. Una passkey sostituisce la tua password: più veloce e impossibile da rubare con il phishing."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에서 패스키를 지원해요. 패스키는 암호를 대신해요. 더 빠르고 피싱으로 탈취할 수 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 支持通行密钥。通行密钥可替代你的密码：登录更快，而且无法被钓鱼攻击窃取。"
          }
        }
      }
    },
