    "Ton iPhone gardera une clé qui permet à ce Mac de s'ouvrir pour les agents, chaque fois avec ton accord et Face ID." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone will keep a key that lets this Mac open for the agents, each time with your approval and Face ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone guardará una clave que permite abrir este Mac para los agentes, cada vez con tu aprobación y Face ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone conserverà una chiave che permette a questo Mac di aprirsi per gli agenti, ogni volta con la tua approvazione e Face ID."
          }
        }
