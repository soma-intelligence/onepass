    "org.invite.footer" : {
      "comment" : "Invitation: who to send the link to.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sende diesen Link nur an die Person, die du einlädst. Wer den Link hat, kann den Beitritt zur Organisation anfragen. Bevor du die Anfrage annimmst, vergleicht ihr einen Code."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send this link only to the person you're inviting. Anyone who has it can ask to join, and you'll compare a code before accepting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía este enlace solo a la persona que invitas. Cualquiera que lo tenga puede pedir unirse, y compararás un código antes de aceptar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie ce lien uniquement à la personne que tu invites. Toute personne qui l'a peut demander à rejoindre l'organisation, et tu compareras un code avant d'accepter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia questo link solo alla persona che inviti. Chiunque lo abbia può chiedere di unirsi, e confronterai un codice prima di accettare."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "초대할 사람에게만 이 링크를 보내 주세요. 링크가 있는 사람은 누구나 가입을 요청할 수 있어요. 요청을 수락하기 전에 코드를 비교해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅将此链接发送给你邀请的人。任何获得链接的人都可以申请加入组织，你需要在批准前核对验证码。"
          }
        }
      }
