            "value" : "Tap the code to show it."
          }
        }
      }
    },
    "Touche un champ d'identifiant : OnePass apparaît au-dessus du clavier et se déverrouille par %@ ou ton mot de passe maître avant de remplir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a sign-in field. OnePass appears above the keyboard and unlocks with %@ or your master password before filling."
          }
        }
      }
    },
    "Tous les coffres redeviennent visibles. %@ reste désactivé jusqu'à ce que tu le réactives avec ton mot de passe maître." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All vaults become visible again. %@ stays off until you turn it back on with your master password."
          }
