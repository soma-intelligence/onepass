    "settings.chooseOnepassFileEncrypted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle eine .onepass-Datei: ein verschlüsseltes Backup dieses Accounts oder ein Backup eines anderen Accounts mit dessen Passphrase. Vorhandene Daten in Kelid werden nicht ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a .onepass file: an encrypted backup of this account, or another account's backup with its passphrase. Nothing already in Kelid is replaced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo .onepass: una copia de seguridad cifrada de esta cuenta, o la copia de otra cuenta con su frase de contraseña. No se sustituye nada de lo que ya hay en Kelid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis un fichier .onepass : une sauvegarde chiffrée de ce compte, ou une sauvegarde d'un autre compte avec sa phrase de passe. Rien de ce qui est déjà dans Kelid n'est remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un file .onepass: un backup cifrato di questo account, oppure il backup di un altro account con la sua passphrase. Niente di ciò che è già in Kelid viene sostituito."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : ".onepass 파일을 선택해요. 이 계정의 암호화된 백업이나 암호 문구가 있는 다른 계정의 백업을 선택할 수 있어요. Kelid에 이미 있는 항목은 대체되지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择一个 .onepass 文件：此账户的加密备份，或其他账户的备份（需要其密码短语）。Kelid 中已有的内容不会被替换。"
          }
        }
      }
    },
