        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac shows a QR code and a code to type on the new device, after “I already have OnePass on another device”. A new device can also show its own QR code, to scan with your iPhone or iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac muestra un código QR y un código que escribir en el nuevo dispositivo, tras «Ya tengo OnePass en otro dispositivo». Un dispositivo nuevo también puede mostrar su propio código QR, para escanearlo con tu iPhone o iPad."
          }
