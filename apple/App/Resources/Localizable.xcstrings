          }
        }
      }
    },
    "Ton prénom (affiché seulement sur tes appareils)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first name (shown only on your devices)"
          }
        }
      }
    },
    "Touche l'étoile d'un élément pour le retrouver ici." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an item's star to find it here."
