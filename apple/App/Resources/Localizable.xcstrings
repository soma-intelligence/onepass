          }
        }
      }
    },
    "settings.security.autofillReuse.footer %@" : {
      "comment" : "Réglages > Sécurité: footer of settings.security.autofillReuse; %@ is Face ID, Touch ID or Optic ID",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach der Bestätigung mit %@ bei „Automatisch ausfüllen“ füllt Kelid 90 Sekunden lang das Passwort und den Code für dieselbe Website oder App ohne erneute Nachfrage aus. Passkeys und Objekte mit der Einstellung „Vor dem Einblenden bestätigen“ erfordern immer eine Bestätigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After %@ in AutoFill, Kelid fills the password and the code of the same site or app for 90 seconds without asking again. Passkeys and items set to “Confirm Before Showing” always ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de %@ en el autorrelleno, Kelid rellena durante 90 segundos la contraseña y el código del mismo sitio o de la misma app sin volver a pedirlo. Las llaves de acceso y los elementos con «Confirmar antes de mostrar» siempre lo piden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après %@ dans le remplissage automatique, Kelid remplit pendant 90 secondes le mot de passe et le code du même site ou de la même app sans le redemander. Les passkeys et les éléments « Confirmer avant d'afficher » le demandent toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo %@ nel riempimento automatico, Kelid compila per 90 secondi la password e il codice dello stesso sito o della stessa app senza richiederlo. Le passkey e gli elementi con «Conferma prima di mostrare» lo chiedono sempre."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자동 완성에서 %@ 인증 후, Kelid는 90초 동안 다시 묻지 않고 같은 사이트나 앱의 암호와 코드를 채워요. 패스키와 ‘보기 전에 확인’으로 설정된 항목은 항상 인증을 요청해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在自动填充中通过 %@ 验证后，Kelid 会在 90 秒内填充同一网站或 App 的密码和验证码，无需再次验证。通行密钥和设为“显示前确认”的项目始终需要验证。"
          }
        }
      }
    },
