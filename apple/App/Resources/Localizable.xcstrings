    "Touche un champ d'identifiant : OnePass apparaît au-dessus du clavier et se déverrouille par %@ ou ton mot de passe maître avant de remplir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a sign-in field. OnePass appears above the keyboard and unlocks with %@ or your master password before filling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
