          }
        }
      }
    },
    "Cet élément demande une confirmation avant d'afficher son contenu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This item asks for confirmation before showing its contents."
