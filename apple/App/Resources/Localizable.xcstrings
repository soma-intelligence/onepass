          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass ha rilevato una modifica della memoria che non ha fatto lui. Per sicurezza, nessun dato viene mostrato e niente viene riparato automaticamente."
          }
        }
      }
    },
