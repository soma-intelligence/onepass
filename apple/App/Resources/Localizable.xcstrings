    "root.exportingEncryptedBackupKeeps" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporting an encrypted backup keeps a copy of what this device holds. Keeping this device's version sends it back to iCloud; taking iCloud's version drops it in favor of what iCloud holds. Both record a restore signed by your account, and detection stays on afterward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar una copia de seguridad cifrada guarda una copia de lo que contiene este dispositivo. Conservar la versión de este dispositivo la devuelve a iCloud; tomar la versión de iCloud la descarta en favor de lo que contiene iCloud. Ambas opciones registran una restauración firmada por tu cuenta, y la detección sigue activa después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter une sauvegarde chiffrée garde une copie de ce que cet appareil contient. Garder la version de cet appareil la renvoie vers iCloud ; prendre la version d'iCloud l'abandonne au profit de ce qu'iCloud contient. Les deux enregistrent une restauration signée par ton compte et la détection reste active ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esportare un backup cifrato conserva una copia di ciò che contiene questo dispositivo. Tenere la versione di questo dispositivo la rimanda a iCloud; prendere la versione di iCloud la scarta a favore di ciò che contiene iCloud. Entrambe registrano un ripristino firmato dal tuo account e il rilevamento resta attivo dopo."
          }
        }
      }
    },
    "root.fileHoldsWholeVault" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file holds your whole vault, encrypted with the passphrase you just chose. Keep it offline, on a USB drive for example: iCloud Drive, messaging apps and other clouds keep a copy elsewhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo contiene toda tu bóveda, cifrada con la frase de contraseña que acabas de elegir. Guárdalo sin conexión, por ejemplo en una memoria USB: iCloud Drive, las apps de mensajería y otras nubes guardan una copia en otro lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient tout ton coffre, chiffré avec la phrase de passe que tu viens de choisir. Range-le hors ligne, par exemple sur une clé USB : iCloud Drive, les messageries et les autres clouds en gardent une copie ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file contiene tutta la tua cassaforte, cifrata con la passphrase che hai appena scelto. Conservalo offline, per esempio su una chiavetta USB: iCloud Drive, le app di messaggistica e gli altri cloud ne tengono una copia altrove."
          }
        }
      }
    },
    "root.fileWillCopiedTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file will be copied to this service's servers and to your other devices. It stays encrypted, but its security then rests on your passphrase alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se copiará en los servidores de este servicio y en tus otros dispositivos. Sigue cifrado, pero su seguridad depende entonces solo de tu frase de contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier sera copié sur les serveurs de ce service et sur tes autres appareils. Il reste chiffré, mais sa sécurité ne tient plus qu'à ta phrase de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file verrà copiato sui server di questo servizio e sugli altri tuoi dispositivi. Resta cifrato, ma la sua sicurezza dipende allora solo dalla tua passphrase."
          }
        }
      }
    },
