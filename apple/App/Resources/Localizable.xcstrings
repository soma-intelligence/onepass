    "root.nothingErasedInIcloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In iCloud wird nichts gelöscht. Ein dort noch vorhandener Tresor lässt sich mit deinem Emergency Kit wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is erased in iCloud. A vault still there can be recovered with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se borra nada en iCloud. Una bóveda que siga allí se puede recuperar con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'est effacé dans iCloud : un coffre qui s'y trouve encore reste récupérable avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente viene cancellato in iCloud. Una cassaforte ancora lì si può recuperare con il tuo Emergency Kit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud에서는 아무것도 지워지지 않아요. iCloud에 남아 있는 보관함은 Emergency Kit로 복구할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
