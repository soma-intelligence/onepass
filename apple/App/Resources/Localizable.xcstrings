    "browse.cliAgentServesSsh" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The CLI agent serves the SSH keys of its vaults to `ssh` and `git`. Every signature asks for your approval in the terminal, with the key title, its fingerprint and the program asking. The private key never leaves the vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente de la CLI sirve las claves SSH de sus bóvedas a `ssh` y `git`. Cada firma pide tu aprobación en el terminal, con el título de la clave, su huella y el programa que la pide. La clave privada nunca sale de la bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent de la CLI sert les clés SSH de ses coffres à `ssh` et à `git`. Chaque signature demande ton accord dans le terminal, avec le titre de la clé, son empreinte et le programme qui la demande. La clé privée ne quitte jamais le coffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agente della CLI fornisce le chiavi SSH delle sue casseforti a `ssh` e `git`. Ogni firma chiede la tua approvazione nel terminale, con il titolo della chiave, la sua impronta e il programma che la chiede. La chiave privata non lascia mai la cassaforte."
          }
        }
      }
    },
    "browse.cliMcpServerSpeaks" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The CLI MCP server speaks JSON-RPC on standard input and output. It only sees vaults created with MCP access, and every use of a secret asks for your approval in the terminal. The agent gets metadata or the masked output of a command, never the value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor MCP de la CLI habla JSON-RPC por la entrada y la salida estándar. Solo ve las bóvedas creadas con acceso MCP, y cada uso de un secreto pide tu aprobación en el terminal. El agente recibe metadatos o la salida enmascarada de un comando, nunca el valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur MCP de la CLI parle JSON-RPC sur l'entrée et la sortie standard. Il ne voit que les coffres créés avec l'accès MCP, et chaque usage d'un secret demande ton accord dans le terminal. L'agent reçoit des métadonnées ou le résultat d'une commande masquée, jamais la valeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server MCP della CLI parla JSON-RPC su input e output standard. Vede solo le casseforti create con l'accesso MCP e ogni uso di un segreto chiede la tua approvazione nel terminale. L'agente riceve metadati o l'output mascherato di un comando, mai il valore."
          }
        }
      }
    },
    "browse.cliUsesOwnData" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The CLI uses its own data folder (`~/.onepass-dev`), not this app’s vaults. On the Mac, the app itself serves the SSH agent and the MCP server on your vaults: Settings > Developer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CLI usa su propia carpeta de datos (`~/.onepass-dev`), no las bóvedas de esta app. En el Mac, la propia app sirve el agente SSH y el servidor MCP sobre tus bóvedas: Ajustes > Desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CLI utilise son propre dossier de données (`~/.onepass-dev`), pas les coffres de cette app. Sur Mac, l'app sert elle-même l'agent SSH et le serveur MCP sur tes coffres : Réglages > Développeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CLI usa la sua cartella di dati (`~/.onepass-dev`), non le casseforti di questa app. Sul Mac, l'app stessa fornisce l'agente SSH e il server MCP sulle tue casseforti: Impostazioni > Sviluppatore."
          }
        }
      }
    },
