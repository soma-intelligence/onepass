    "settings.itemsRestoredButRestore" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Objekte wurden wiederhergestellt, aber die Wiederherstellung konnte nicht für deine anderen Geräte gespeichert werden. Synchronisiere und stelle diese Datei dann erneut wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The items are restored, but the restore could not be recorded for your other devices. Sync, then restore this file again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos se han restaurado, pero no se pudo registrar la restauración para tus otros dispositivos. Sincroniza y vuelve a restaurar este archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
