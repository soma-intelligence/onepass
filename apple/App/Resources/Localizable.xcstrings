            "value" : "Print the Kit"
          }
        }
      }
    },
    "Inchangés depuis plus d'un an. Pense à les renouveler." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unchanged for over a year. Consider renewing them."
          }
        }
