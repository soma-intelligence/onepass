        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer esta imagen. Prueba con un JPEG, PNG o HEIC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere questa immagine. Prova un JPEG, PNG o HEIC."
          }
        }
      }
    },
    "Cette liste est signée par ton compte : le serveur ne peut ni ajouter ni cacher un appareil." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This list is signed by your account: the server can neither add nor hide a device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta lista está firmada por tu cuenta: el servidor no puede añadir ni ocultar un dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elenco è firmato dal tuo account: il server non può né aggiungere né nascondere un dispositivo."
          }
        }
      }
    },
    "Cette sauvegarde n'est pas pour ce compte : elle s'ouvre avec la phrase de passe choisie à l'export." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
