    "accounts.settings.footer" : {
      "comment" : "Settings > Accounts: footer under the list of accounts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each account has its own master password, Secret Key and lock. Nothing moves from one account to another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cuenta tiene su contraseña maestra, su Secret Key y su bloqueo. Nada pasa de una cuenta a otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque compte a son mot de passe maître, sa Secret Key et son verrouillage. Rien ne passe d'un compte à l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni account ha la sua password principale, la sua Secret Key e il suo blocco. Niente passa da un account all'altro."
          }
        }
      }
    },
