      }
    },
    "OnePass retient le compte que tu choisis sur chaque site pour te le proposer en premier la fois suivante." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass remembers the account you pick on each site and offers it first the next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass recuerda la cuenta que eliges en cada sitio y te la ofrece primero la próxima vez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass ricorda l'account che scegli su ogni sito e te lo propone per primo la volta successiva."
          }
        }
      }
    },
    "OnePass se verrouille après ce délai d'inactivité et quand l'app reste en arrière-plan aussi longtemps." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass locks after this much inactivity, and when the app stays in the background this long."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass se bloquea tras este tiempo de inactividad y cuando la app se queda en segundo plano este tiempo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass si blocca dopo questo tempo di inattività e quando l'app resta in background così a lungo."
          }
        }
      }
    },
