    "Ton autre appareil le valide : tu compares un code sur les deux écrans. Rien ne passe par un serveur." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein anderes Gerät bestätigt es: Du vergleichst einen Code auf beiden Bildschirmen. Nichts wird über einen Server übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your other device approves it: you compare a code on both screens. Nothing goes through a server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu otro dispositivo lo aprueba: comparas un código en las dos pantallas. Nada pasa por un servidor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo lo approva: confronti un codice sui due schermi. Niente passa da un server."
          }
        },
        "ko" : {
