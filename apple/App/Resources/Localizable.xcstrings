    "root.anythingNotSyncedYet" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles, was noch nicht synchronisiert wurde, geht verloren. Du kannst es von einem anderen Gerät oder mit deinem Emergency Kit erneut hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything not synced yet will be lost. You can add it again from another device or with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que aún no se haya sincronizado se perderá. Podrás volver a añadirlo desde otro dispositivo o con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui n'a pas encore été synchronisé sera perdu. Tu pourras l'ajouter de nouveau depuis un autre appareil ou avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che non è ancora sincronizzato andrà perso. Potrai aggiungerlo di nuovo da un altro dispositivo o con il tuo Emergency Kit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아직 동기화되지 않은 내용은 사라져요. 다른 기기나 Emergency Kit을 통해 다시 추가할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "尚未同步的内容将会丢失。你可以从其他设备或使用 Emergency Kit 重新添加。"
          }
        }
      }
