            "value" : "Una sessione ospite si approva da iPhone o iPad."
          }
        }
      }
    },
    "Utilise tes secrets dans le terminal, avec Git et tes agents IA, sans les copier en clair." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
