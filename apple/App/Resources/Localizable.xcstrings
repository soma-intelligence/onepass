    "root.changesMadeOnDevice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Änderungen auf diesem Gerät, die noch nicht an iCloud gesendet wurden, gehen verloren, sofern sie nicht exportiert wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes made on this device and not yet sent to iCloud will be lost unless they were exported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios hechos en este dispositivo y aún no enviados a iCloud se perderán si no se han exportado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les changements faits sur cet appareil et pas encore envoyés à iCloud seront perdus s'ils n'ont pas été exportés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche fatte su questo dispositivo e non ancora inviate a iCloud andranno perse se non sono state esportate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기에서 변경한 내용 중 아직 iCloud에 전송되지 않은 내용은 내보내지 않았다면 사라져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在此设备上所做但尚未发送到 iCloud 的更改，如果未导出，将会丢失。"
          }
        }
      }
    },
    "root.chooseLongPassphraseDont" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle eine lange Passphrase, die du nirgendwo sonst verwendest, zum Beispiel mehrere Wörter. Kelid lehnt Passphrasen ab, die zu leicht zu erraten sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a long passphrase you don't use anywhere else, several words for example. Kelid refuses a passphrase that is too easy to guess."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una frase larga que no uses en ningún otro sitio, por ejemplo varias palabras. Kelid rechaza una frase demasiado fácil de adivinar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis une phrase longue que tu n'utilises nulle part ailleurs, par exemple plusieurs mots. Kelid refuse une phrase trop facile à deviner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una frase lunga che non usi altrove, per esempio più parole. Kelid rifiuta una frase troppo facile da indovinare."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "여러 단어를 조합하는 등 다른 곳에서 사용하지 않는 긴 암호 문구를 선택하세요. Kelid는 추측하기 쉬운 암호 문구를 허용하지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请选择一个未在其他地方使用过的长密码短语，例如由多个词组成的短语。Kelid 不接受太容易猜到的密码短语。"
          }
        }
      }
    },
    "root.chooseOfflineLocationSuch" : {
