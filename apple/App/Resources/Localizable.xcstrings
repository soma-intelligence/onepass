    "pairing.chooseIAlreadyHave" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle „Ich habe Kelid bereits auf einem anderen Gerät“. Scanne dann diesen QR-Code mit der Kamera von Kelid oder gib den Code ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose “I already have Kelid on another device”, then scan this QR code with Kelid's camera, or type the code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige «Ya tengo Kelid en otro dispositivo» y escanea este código QR con la cámara de Kelid, o escribe el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis « J'ai déjà Kelid sur un autre appareil », puis scanne ce QR code avec la caméra de Kelid, ou saisis le code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli «Ho già Kelid su un altro dispositivo», poi scansiona questo codice QR con la fotocamera di Kelid, o digita il codice."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘다른 기기에서 이미 Kelid를 사용하고 있어요’를 선택한 다음, Kelid 카메라로 이 QR 코드를 스캔하거나 코드를 입력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择“我已在其他设备上使用 Kelid”，然后用 Kelid 的相机扫描此二维码，或输入验证码。"
          }
        }
      }
    },
