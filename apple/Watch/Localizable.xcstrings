    "watchRootView.markItemsOnApple" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Markiere Objekte in Kelid auf deinem iPhone als „Auf der Apple Watch“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark items “On Apple Watch” in Kelid on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca elementos «En el Apple Watch» en Kelid en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque des éléments « Sur l'Apple Watch » dans Kelid sur ton iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegna elementi «Su Apple Watch» in Kelid su iPhone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone의 Kelid에서 항목을 ‘Apple Watch에 표시’로 설정해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你 iPhone 上的 Kelid 中，将项目标记为“在 Apple Watch 上”。"
