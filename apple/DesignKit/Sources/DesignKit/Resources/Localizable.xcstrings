    "chipBadge.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft die Signatur des ausstellenden Staates, nicht ob der Chip ein Unikat ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks the issuing state's signature, not that the chip is one of a kind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la firma del Estado, no que el chip sea único."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie la signature de l'État, pas l'unicité de la puce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la firma dello Stato, non l'unicità del chip."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발급국의 서명을 확인하며, 칩이 유일한 칩인지는 확인하지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证的是签发国的签名，而不是芯片的唯一性。"
          }
        }
      }
    },
