    "Trop facile à deviner : allonge-la ou ajoute des mots." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too easy to guess: make it longer or add words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado fácil de adivinar: alárgala o añade palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
