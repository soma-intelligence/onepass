    "Il n'est pas imprimé sur ce kit. Si tu choisis de le garder sur papier, écris-le à la main sur la ligne ci-dessous, jamais dans un fichier ni une photo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is not printed on this kit. If you choose to keep it on paper, write it by hand on the line below, never in a file or a photo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'est pas imprimé sur ce kit. Si tu choisis de le garder sur papier, écris-le à la main sur la ligne ci-dessous, jamais dans un fichier ni une photo."
          }
        }
      }
    },
    "Impossible de lire ce compte iCloud. Vérifie ta connexion puis réessaie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't read this iCloud account. Check your connection, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire ce compte iCloud. Vérifie ta connexion puis réessaie."
          }
        }
      }
    },
    "Impossible de ranger la Secret Key dans le trousseau de cet appareil. La connexion a été annulée." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Secret Key couldn't be stored in this device's keychain. Sign-in was canceled."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de ranger la Secret Key dans le trousseau de cet appareil. La connexion a été annulée."
          }
        }
      }
    },
    "Impossible de ranger la Secret Key dans le trousseau de cet appareil. Le coffre n'a pas été créé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Secret Key couldn't be stored in this device's keychain. The vault was not created."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de ranger la Secret Key dans le trousseau de cet appareil. Le coffre n'a pas été créé."
          }
        }
      }
    },
    "Imprime ce kit et range la feuille hors ligne, dans un endroit sûr (coffre, tiroir fermé à clé). Ne la photographie jamais et ne la stocke jamais dans le cloud (iCloud Drive, Photos, messageries)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print this kit and keep the sheet offline, somewhere safe (a safe, a locked drawer). Never take a photo of it and never store it in the cloud (iCloud Drive, Photos, messaging apps)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime ce kit et range la feuille hors ligne, dans un endroit sûr (coffre, tiroir fermé à clé). Ne la photographie jamais et ne la stocke jamais dans le cloud (iCloud Drive, Photos, messageries)."
          }
        }
      }
    },
