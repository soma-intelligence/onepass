          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta un dato de OnePass en el llavero del dispositivo. Introduce tu contraseña maestra. Si has reinstalado OnePass, restaura tu cuenta con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une donnée de OnePass manque dans le trousseau de l'appareil. Saisis ton mot de passe maître. Si tu as réinstallé OnePass, restaure ton compte avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca un dato di OnePass nel portachiavi del dispositivo. Inserisci la password principale. Se hai reinstallato OnePass, ripristina il tuo account con il tuo Emergency Kit."
          }
        }
      }
    },
    "errorText.onepassIsntAllowedTo" : {
