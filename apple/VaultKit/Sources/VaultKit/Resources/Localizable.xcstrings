    "session.onepasssLocalStorageCant" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der lokale Speicher von OnePass kann nicht gelesen werden. Beende OnePass und öffne die App wieder. Wenn der Fehler erneut auftritt, stelle dein Konto mit deinem Emergency Kit wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass's local storage can't be read. Quit and reopen OnePass. If it happens again, restore your account with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer el almacenamiento local de OnePass. Sal de OnePass y vuelve a abrirlo. Si vuelve a ocurrir, restaura tu cuenta con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage local de OnePass est illisible. Quitte et rouvre OnePass. Si l'erreur revient, restaure ton compte avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archivio locale di OnePass è illeggibile. Esci da OnePass e riaprilo. Se succede di nuovo, ripristina il tuo account con il tuo Emergency Kit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OnePass의 로컬 저장 공간을 읽을 수 없어요. OnePass를 종료한 다음 다시 열어 주세요. 오류가 반복되면 Emergency Kit으로 계정을 복원해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无法读取 OnePass 的本地存储。请退出并重新打开 OnePass。如果错误再次出现，请使用你的 Emergency Kit 恢复账户。"
          }
        }
      }
    },
