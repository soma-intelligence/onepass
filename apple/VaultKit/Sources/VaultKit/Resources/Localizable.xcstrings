          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass no ha podido cifrar ni descifrar este dato. Vuelve a intentarlo. Si vuelve a ocurrir, sal de OnePass y vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass n'a pas pu chiffrer ou déchiffrer cette donnée. Réessaie. Si l'erreur revient, quitte et rouvre OnePass."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass non è riuscito a cifrare o decifrare questo dato. Riprova. Se succede di nuovo, esci da OnePass e riaprilo."
          }
        }
      }
    },
    "Opération annulée. Recommence quand tu veux." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelled. Start again whenever you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelado. Empieza de nuevo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opération annulée. Recommence quand tu veux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operazione annullata. Ricomincia quando vuoi."
          }
        }
      }
    },
    "Ton stockage iCloud est plein. Libère de l'espace dans iCloud, puis synchronise à nouveau." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iCloud storage is full. Free up space in iCloud, then sync again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu almacenamiento de iCloud está lleno. Libera espacio en iCloud y vuelve a sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton stockage iCloud est plein. Libère de l'espace dans iCloud, puis synchronise à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio iCloud è pieno. Libera spazio in iCloud, poi sincronizza di nuovo."
          }
        }
      }
    },
    "Un fichier porte déjà ce nom. Choisis un autre nom." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file with this name already exists. Pick another name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo con este nombre. Elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier porte déjà ce nom. Choisis un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un file con questo nome. Scegli un altro nome."
          }
        }
      }
    },
    "Une autre app utilise ce fichier. Ferme-la, puis réessaie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app is using this file. Close it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está usando este archivo. Ciérrala e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app utilise ce fichier. Ferme-la, puis réessaie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'altra app sta usando questo file. Chiudila, poi riprova."
          }
        }
      }
    },
    "Une donnée de OnePass manque dans le trousseau de l'appareil. Saisis ton mot de passe maître. Si tu as réinstallé OnePass, restaure ton compte avec ton Emergency Kit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A OnePass entry is missing from the device keychain. Enter your master password. If you reinstalled OnePass, restore your account with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta un dato de OnePass en el llavero del dispositivo. Introduce tu contraseña maestra. Si has reinstalado OnePass, restaura tu cuenta con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une donnée de OnePass manque dans le trousseau de l'appareil. Saisis ton mot de passe maître. Si tu as réinstallé OnePass, restaure ton compte avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca un dato di OnePass nel portachiavi del dispositivo. Inserisci la password principale. Se hai reinstallato OnePass, ripristina il tuo account con il tuo Emergency Kit."
          }
        }
      }
    },
    "Une donnée du trousseau est illisible. Réessaie. Si l'erreur revient, restaure ton compte avec ton Emergency Kit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A keychain entry can't be read. Try again. If it happens again, restore your account with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer un dato del llavero. Vuelve a intentarlo. Si vuelve a ocurrir, restaura tu cuenta con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une donnée du trousseau est illisible. Réessaie. Si l'erreur revient, restaure ton compte avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dato del portachiavi è illeggibile. Riprova. Se succede di nuovo, ripristina il tuo account con il tuo Emergency Kit."
          }
        }
      }
    },
    "Une erreur inattendue est survenue. Réessaie. Si l'erreur revient, quitte et rouvre OnePass." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something unexpected went wrong. Try again. If it happens again, quit and reopen OnePass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha producido un error inesperado. Vuelve a intentarlo. Si vuelve a ocurrir, sal de OnePass y vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur inattendue est survenue. Réessaie. Si l'erreur revient, quitte et rouvre OnePass."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore imprevisto. Riprova. Se succede di nuovo, esci da OnePass e riaprilo."
          }
        }
      }
    },
    "iCloud a refusé la synchronisation. Réessaie plus tard. Si l'erreur revient, vérifie ton compte iCloud dans Réglages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud refused to sync. Try again later. If it happens again, check your iCloud account in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ha rechazado la sincronización. Vuelve a intentarlo más tarde. Si vuelve a ocurrir, comprueba tu cuenta de iCloud en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud a refusé la synchronisation. Réessaie plus tard. Si l'erreur revient, vérifie ton compte iCloud dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ha rifiutato la sincronizzazione. Riprova più tardi. Se succede di nuovo, controlla il tuo account iCloud in Impostazioni."
          }
        }
      }
    },
    "iCloud ne répond pas pour le moment. OnePass réessaiera tout seul." : {
      "localizations" : {
