    "Autorisation inconnue." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unknown permission."
          }
        }
      }
    },
    "C'est une archive OnePass chiffrée : elle ne s'importe pas ici." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is an encrypted OnePass archive. It can't be imported here."
