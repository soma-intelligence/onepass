          }
        }
      }
    },
    "Cet export Bitwarden est chiffré. Refais l'export en JSON non chiffré (ou en CSV), puis réessaie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Bitwarden export is encrypted. Export again as unencrypted JSON (or CSV), then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet export Bitwarden est chiffré. Refais l'export en JSON non chiffré (ou en CSV), puis réessaie."
          }
        }
      }
    },
    "Cet export Dashlane est chiffré. Refais l'export en CSV, puis réessaie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Dashlane export is encrypted. Export again as CSV, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet export Dashlane est chiffré. Refais l'export en CSV, puis réessaie."
          }
        }
      }
    },
    "Cette Secret Key contient une faute de frappe : vérifie chaque caractère sur ton Emergency Kit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Secret Key has a typo. Check each character against your Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette Secret Key contient une faute de frappe : vérifie chaque caractère sur ton Emergency Kit."
          }
        }
      }
    },
    "Cette Secret Key ne correspond pas à ce compte, ou le mot de passe est faux." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Secret Key doesn't match this account, or the password is wrong."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette Secret Key ne correspond pas à ce compte, ou le mot de passe est faux."
          }
        }
      }
    },
    "Cette action n'est possible que lorsque le compte a disparu du stockage ou que sa Secret Key manque." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is only possible when the account is gone from storage or its Secret Key is missing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action n'est possible que lorsque le compte a disparu du stockage ou que sa Secret Key manque."
          }
        }
      }
    },
    "Cette clé est chiffrée : saisis sa phrase de passe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This key is encrypted: enter its passphrase."
          }
        }
      }
    },
    "Cette clé s'ajoute à ton mot de passe maître pour protéger ton coffre. Elle est stockée sur tes appareils et n'est jamais envoyée à personne." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This key works with your master password to protect your vault. It's stored on your devices and never sent to anyone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé s'ajoute à ton mot de passe maître pour protéger ton coffre. Elle est stockée sur tes appareils et n'est jamais envoyée à personne."
          }
        }
      }
    },
    "Cette donnée existe déjà dans le trousseau. Réessaie. Si l'erreur revient, redémarre l'appareil." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This entry already exists in the keychain. Try again. If it happens again, restart the device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette donnée existe déjà dans le trousseau. Réessaie. Si l'erreur revient, redémarre l'appareil."
          }
        }
      }
    },
    "Cette sauvegarde a été modifiée ou abîmée : sa signature ou son contenu ne correspond pas. Rien n'a été restauré." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup was changed or damaged: its signature or its content does not match. Nothing was restored."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde a été modifiée ou abîmée : sa signature ou son contenu ne correspond pas. Rien n'a été restauré."
          }
        }
      }
    },
    "Cette sauvegarde appartient à un autre compte et n'a pas de phrase de passe : elle ne s'ouvre qu'avec ce compte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
