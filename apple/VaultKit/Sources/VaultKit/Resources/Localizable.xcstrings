    "errorText.copyOfOnepassCant" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Version von OnePass kann nicht auf den Schlüsselbund des Geräts zugreifen. Installiere OnePass erneut aus derselben Quelle (App Store, TestFlight oder Xcode)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy of OnePass can't use the device keychain. Reinstall OnePass from the same source (App Store, TestFlight or Xcode)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de OnePass no puede usar el llavero del dispositivo. Reinstala OnePass desde la misma fuente (App Store, TestFlight o Xcode)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de OnePass n'a pas accès au trousseau de l'appareil. Réinstalle OnePass depuis la même source (App Store, TestFlight ou Xcode)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia di OnePass non può usare il portachiavi del dispositivo. Reinstalla OnePass dalla stessa fonte (App Store, TestFlight o Xcode)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 버전의 OnePass는 기기 키체인에 접근할 수 없어요. 같은 출처(App Store, TestFlight 또는 Xcode)에서 OnePass를 다시 설치해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此版本的 OnePass 无法访问设备钥匙串。请从同一来源（App Store、TestFlight 或 Xcode）重新安装 OnePass。"
          }
        }
      }
    },
