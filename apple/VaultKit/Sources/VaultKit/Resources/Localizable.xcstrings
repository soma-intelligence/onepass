    "Ce code n'est pas valide. Vérifie-le : 8 caractères, par exemple K7QM-4XPR." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code is not valid. Check it: 8 characters, for example K7QM-4XPR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
