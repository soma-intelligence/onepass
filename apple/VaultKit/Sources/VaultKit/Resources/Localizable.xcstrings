    "errorText.onepassEntryMissingFrom" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein OnePass-Eintrag fehlt im Schlüsselbund des Geräts. Gib dein Master-Passwort ein. Wenn du OnePass neu installiert hast, stelle deinen Account mit deinem Emergency Kit wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A OnePass entry is missing from the device keychain. Enter your master password. If you reinstalled OnePass, restore your account with your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta un dato de OnePass en el llavero del dispositivo. Introduce tu contraseña maestra. Si has reinstalado OnePass, restaura tu cuenta con tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une donnée de OnePass manque dans le trousseau de l'appareil. Saisis ton mot de passe maître. Si tu as réinstallé OnePass, restaure ton compte avec ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca un dato di OnePass nel portachiavi del dispositivo. Inserisci la password principale. Se hai reinstallato OnePass, ripristina il tuo account con il tuo Emergency Kit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기기 키체인에 OnePass 데이터가 없어요. 마스터 암호를 입력해 주세요. OnePass를 다시 설치했다면 Emergency Kit으로 계정을 복원해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "设备钥匙串中缺少 OnePass 的某个条目。请输入你的主密码。如果你重新安装过 OnePass，请使用你的 Emergency Kit 恢复账户。"
          }
        }
      }
    },
    "errorText.onepassIsntAllowedTo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
