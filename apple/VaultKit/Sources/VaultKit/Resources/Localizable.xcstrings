    "sharing.removal.prompt %@ %@ %lld" : {
      "comment" : "Spec 9.3, after removing a member: %1$@ member's name, %2$@ vault name, %3$lld items they could read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ sieht keine neuen Inhalte mehr in %2$@. Die Person könnte bereits gesehene Inhalte gespeichert haben: %3$lld Passwörter. Möchtest du sie ändern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ won't see anything new in %2$@. They may have kept what they already saw: %3$lld passwords. Change them?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya no verá nada nuevo en %2$@. Puede haber guardado lo que ya vio: %3$lld contraseñas. ¿Cambiarlas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne verra plus rien de nouveau dans %2$@. Il a pu garder ce qu'il a déjà vu : %3$lld mots de passe. Les changer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non vedrà più niente di nuovo in %2$@. Potrebbe aver conservato ciò che ha già visto: %3$lld password. Cambiarle?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@님은 이제 %2$@의 새로운 내용을 볼 수 없어요. 이미 본 암호 %3$lld개는 보관했을 수 있어요. 변경할까요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ 将无法再查看 %2$@ 中的新内容。对方可能保留了已查看的 %3$lld 个密码。要更改这些密码吗？"
          }
        }
      }
    },
