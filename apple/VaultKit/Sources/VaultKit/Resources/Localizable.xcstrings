    "travel.error.nothingLeaves" : {
      "comment" : "Error when Travel Mode would remove nothing.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nichts würde von diesem Gerät entfernt: Alle deine Tresore sind für Reisen sicher und kein Objekt ist ausgeblendet oder geschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing would leave this device: all your vaults are safe for travel and no item is hidden or protected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada saldría de este dispositivo: todas tus bóvedas son seguras para viajar y ningún elemento está oculto ni protegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne quitterait cet appareil : tous tes coffres sont sûrs en voyage et aucun élément n'est caché ni protégé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente lascerebbe questo dispositivo: tutte le tue casseforti sono sicure in viaggio e nessun elemento è nascosto o protetto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기에서 제거될 항목이 없어요. 모든 보관함이 여행 시 안전하며, 가려지거나 보호된 항목이 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "不会从此设备移除任何内容：你的所有保险库都适合旅行，没有项目被隐藏或保护。"
          }
        }
      }
    },
