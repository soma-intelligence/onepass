        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code n'est pas valide. Vérifie-le : 8 caractères, par exemple K7QM-4XPR."
          }
        }
      }
    },
    "Ce compte a déjà une passkey OnePass pour ce site." : {
      "localizations" : {
