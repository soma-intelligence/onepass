    "Sans ton mot de passe maître et ta Secret Key, personne ne peut ouvrir ton coffre, pas même nous. Il n'existe aucun moyen de les récupérer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without your master password and your Secret Key, nobody can open your vault, not even us. There's no way to recover them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin tu contraseña maestra y tu Secret Key, nadie puede abrir tu bóveda, ni siquiera nosotros. No hay forma de recuperarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans ton mot de passe maître et ta Secret Key, personne ne peut ouvrir ton coffre, pas même nous. Il n'existe aucun moyen de les récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza la password principale e la Secret Key, nessuno può aprire la tua cassaforte, nemmeno noi. Non esiste alcun modo per recuperarle."
          }
        }
      }
    },
    "Scanne ce QR code avec OnePass sur ton iPhone ou ton iPad pour ajouter un appareil. Sur un Mac, tape la Secret Key à la main." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan this QR code with OnePass on your iPhone or iPad to add a device. On a Mac, type the Secret Key by hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea este código QR con OnePass en tu iPhone o iPad para añadir un dispositivo. En un Mac, escribe la Secret Key a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne ce QR code avec OnePass sur ton iPhone ou ton iPad pour ajouter un appareil. Sur un Mac, tape la Secret Key à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona questo codice QR con OnePass su iPhone o iPad per aggiungere un dispositivo. Su un Mac, digita la Secret Key a mano."
          }
        }
      }
    },
    "Si tu penses que cette page a été vue par quelqu'un d'autre, crée un nouveau compte et déplace tes données." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you think someone else has seen this page, create a new account and move your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si crees que otra persona ha visto esta página, crea una cuenta nueva y traslada tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu penses que cette page a été vue par quelqu'un d'autre, crée un nouveau compte et déplace tes données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pensi che qualcun altro abbia visto questa pagina, crea un nuovo account e sposta i tuoi dati."
          }
        }
      }
    },
