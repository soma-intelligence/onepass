    "errorText.deviceCouldntReadOr" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Gerät konnte die Daten nicht lesen oder schreiben. Versuche es erneut. Wenn der Fehler wieder auftritt, starte das Gerät neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device couldn't read or write the data. Try again. If it happens again, restart the device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no ha podido leer ni escribir el dato. Vuelve a intentarlo. Si vuelve a ocurrir, reinicia el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appareil n'a pas pu lire ou écrire la donnée. Réessaie. Si l'erreur revient, redémarre l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non è riuscito a leggere o scrivere il dato. Riprova. Se succede di nuovo, riavvia il dispositivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기기에서 데이터를 읽거나 쓸 수 없어요. 다시 시도해 주세요. 오류가 반복되면 기기를 재시동해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "设备无法读取或写入数据。请重试。如果错误再次出现，请重新启动设备。"
          }
        }
      }
    },
