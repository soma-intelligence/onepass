    "Trop d'essais. Le compte reçu a été effacé de cet appareil : recommence l'appairage." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many attempts. The received account was erased from this device: start the pairing again."
          }
