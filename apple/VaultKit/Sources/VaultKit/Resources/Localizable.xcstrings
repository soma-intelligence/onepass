        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé s'ajoute à ton mot de passe maître pour protéger ton coffre. Elle est stockée sur tes appareils et n'est jamais envoyée à personne."
          }
        }
      }
    },
    "Cette sauvegarde a été modifiée ou abîmée : sa signature ou son contenu ne correspond pas. Rien n'a été restauré." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
