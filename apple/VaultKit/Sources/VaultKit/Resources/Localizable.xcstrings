    "Associer %@ à OnePass" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair %@ with OnePass"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associer %@ à OnePass"
          }
        }
      }
    },
    "Aucun compte iCloud n'est disponible." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iCloud account is available."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte iCloud n'est disponible."
          }
        }
      }
    },
    "C'est une archive OnePass chiffrée : elle ne s'importe pas ici." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is an encrypted OnePass archive. It can't be imported here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est une archive OnePass chiffrée : elle ne s'importe pas ici."
          }
        }
      }
    },
    "Ce compte a déjà une passkey OnePass pour ce site." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account already has a OnePass passkey for this site."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte a déjà une passkey OnePass pour ce site."
          }
        }
      }
    },
    "Ce compte iCloud contient déjà un autre coffre OnePass. Reviens au compte iCloud d'origine pour synchroniser." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iCloud account already holds another OnePass vault. Switch back to the original iCloud account to sync."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte iCloud contient déjà un autre coffre OnePass. Reviens au compte iCloud d'origine pour synchroniser."
          }
        }
      }
    },
    "Ce fichier est trop gros pour être importé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file is too large to import."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier est trop gros pour être importé."
          }
        }
      }
    },
    "Ce fichier ne correspond pas au format choisi, ou il est abîmé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file doesn't match the chosen format, or it's damaged."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier ne correspond pas au format choisi, ou il est abîmé."
          }
        }
      }
    },
    "Ce kit plus ton mot de passe maître donnent un accès complet à ton coffre. Imprime-le et range la feuille hors ligne. Ne le photographie jamais et ne le stocke jamais dans le cloud." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This kit plus your master password give full access to your vault. Print it and keep the sheet offline. Never take a photo of it and never store it in the cloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce kit plus ton mot de passe maître donnent un accès complet à ton coffre. Imprime-le et range la feuille hors ligne. Ne le photographie jamais et ne le stocke jamais dans le cloud."
          }
        }
      }
    },
    "Cet export Bitwarden est chiffré. Refais l'export en JSON non chiffré (ou en CSV), puis réessaie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Bitwarden export is encrypted. Export again as unencrypted JSON (or CSV), then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet export Bitwarden est chiffré. Refais l'export en JSON non chiffré (ou en CSV), puis réessaie."
          }
        }
      }
    },
    "Cet export Dashlane est chiffré. Refais l'export en CSV, puis réessaie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Dashlane export is encrypted. Export again as CSV, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet export Dashlane est chiffré. Refais l'export en CSV, puis réessaie."
          }
        }
      }
    },
    "Cette Secret Key contient une faute de frappe : vérifie chaque caractère sur ton Emergency Kit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Secret Key has a typo. Check each character against your Emergency Kit."
