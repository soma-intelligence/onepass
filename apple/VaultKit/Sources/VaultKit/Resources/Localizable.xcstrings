    "errorText.copyOfOnepassCant" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy of OnePass can't use the device keychain. Reinstall OnePass from the same source (App Store, TestFlight or Xcode)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de OnePass no puede usar el llavero del dispositivo. Reinstala OnePass desde la misma fuente (App Store, TestFlight o Xcode)."
          }
        },
        "fr" : {
