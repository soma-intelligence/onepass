    "recovery.alert %@ %@ %@" : {
      "comment" : "Spec 11.5, on the member's devices (locked too): %1$@ organizer, %2$@ date, %3$@ time.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ asked to recover your account. It will be possible on %2$@ at %3$@. If this isn't you, cancel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pidió recuperar tu cuenta. Será posible el %2$@ a las %3$@. Si no fuiste tú, cancela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a demandé à récupérer ton compte. Ce sera possible le %2$@ à %3$@. Si ce n'est pas toi, annule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha chiesto di recuperare il tuo account. Sarà possibile il %2$@ alle %3$@. Se non sei tu, annulla."
          }
        }
      }
    },
    "recovery.enroll.riskICloud %@" : {
      "comment" : "Spec 11.4, before enrolling (iCloud account): %@ is the organizer.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ and someone with access to your iCloud account could open your vault together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y alguien con acceso a tu cuenta de iCloud podrían abrir juntos tu bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et quelqu'un qui aurait accès à ton compte iCloud pourraient ensemble ouvrir ton coffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e qualcuno con accesso al tuo account iCloud potrebbero aprire insieme la tua cassaforte."
          }
        }
      }
    },
