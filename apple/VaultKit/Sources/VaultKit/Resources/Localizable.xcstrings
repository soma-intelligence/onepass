{
  "sourceLanguage" : "fr",
  "strings" : {
    "accounts.error.alreadyOnDevice" : {
      "comment" : "Add account: the account signed in is already on this device in another slot.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account is already on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta ya está en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte est déjà sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account è già su questo dispositivo."
          }
        }
      }
    },
    "accounts.error.needsAccountID" : {
      "comment" : "Signing in to an added account: several accounts of this iCloud are not on this device, so the account id of the Emergency Kit is needed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Several accounts in your iCloud aren't on this device. Scan the QR code of your Emergency Kit or enter the account ID printed on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varias cuentas de tu iCloud no están en este dispositivo. Escanea el código QR de tu Emergency Kit o introduce el identificador de cuenta impreso en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs comptes de ton iCloud ne sont pas sur cet appareil. Scanne le QR code de ton Emergency Kit ou saisis l'identifiant du compte imprimé dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diversi account del tuo iCloud non sono su questo dispositivo. Scansiona il codice QR del tuo Emergency Kit o inserisci l'identificativo dell'account stampato sopra."
          }
        }
      }
    },
    "accounts.error.notInICloud" : {
      "comment" : "Signing in to an added account: no account with that id in this iCloud.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account with this ID in your iCloud. Check the ID printed on your Emergency Kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna cuenta con este identificador en tu iCloud. Comprueba el identificador impreso en tu Emergency Kit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte avec cet identifiant dans ton iCloud. Vérifie l'identifiant imprimé sur ton Emergency Kit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account con questo identificativo nel tuo iCloud. Controlla l'identificativo stampato sul tuo Emergency Kit."
          }
        }
      }
    },
    "accounts.error.primaryAccount" : {
      "comment" : "Settings > Accounts: the first account cannot be removed, only reset.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device's first account can't be removed. To erase it, reset OnePass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera cuenta del dispositivo no se puede quitar. Para borrarla, restablece OnePass."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier compte de l'appareil ne se retire pas. Pour l'effacer, réinitialise OnePass."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo account del dispositivo non si può rimuovere. Per cancellarlo, reimposta OnePass."
          }
        }
      }
    },
    "accounts.error.serverUnavailable" : {
      "comment" : "Add account sheet: a managed (organisation) account cannot be created yet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account connects to your organization's server, which isn't available in this version yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta se conecta al servidor de tu organización, que aún no está disponible en esta versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte se connecte au serveur de ton organisation, qui n'est pas encore disponible dans cette version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account si collega al server della tua organizzazione, che non è ancora disponibile in questa versione."
          }
        }
      }
    },
    "accounts.error.storeMismatch" : {
      "comment" : "Data refused screen: the store file of an account holds another account.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account's data doesn't match the expected account. Nothing is opened. Remove this account from the device, then sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de esta cuenta no coinciden con la cuenta esperada. No se abre nada. Quita esta cuenta del dispositivo y vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de ce compte ne correspondent pas au compte attendu. Rien n'est ouvert. Retire ce compte de l'appareil puis connecte-toi à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati di questo account non corrispondono all'account previsto. Non viene aperto nulla. Rimuovi questo account dal dispositivo, poi accedi di nuovo."
          }
        }
      }
    },
    "Aucun appareil n'affiche ce code. Vérifie le code, rapproche les deux appareils et vérifie qu'ils sont sur le même Wi-Fi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No device is showing this code. Check the code, bring the two devices closer and make sure they are on the same Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún dispositivo muestra este código. Comprueba el código, acerca los dos dispositivos y asegúrate de que están en la misma Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun appareil n'affiche ce code. Vérifie le code, rapproche les deux appareils et vérifie qu'ils sont sur le même Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun dispositivo mostra questo codice. Controlla il codice, avvicina i due dispositivi e verifica che siano sulla stessa Wi-Fi."
          }
        }
      }
    },
