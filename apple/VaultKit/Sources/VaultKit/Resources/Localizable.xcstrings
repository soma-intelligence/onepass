    "emergencyKit.toAddNewDevice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To add a new device, open OnePass, choose “I have my Emergency Kit”, then type or scan the Secret Key and enter your master password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para añadir un dispositivo nuevo, abre OnePass, elige «Tengo mi Emergency Kit», escribe o escanea la Secret Key e introduce tu contraseña maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ajouter un nouvel appareil, ouvre OnePass, choisis « J'ai mon Emergency Kit », puis saisis ou scanne la Secret Key et entre ton mot de passe maître."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aggiungere un nuovo dispositivo, apri OnePass, scegli «Ho il mio Emergency Kit», poi digita o scansiona la Secret Key e inserisci la password principale."
          }
        }
      }
    },
    "emergencyKit.withoutMasterPasswordAnd" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without your master password and your Secret Key, nobody can open your vault, not even us. There's no way to recover them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin tu contraseña maestra y tu Secret Key, nadie puede abrir tu bóveda, ni siquiera nosotros. No hay forma de recuperarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans ton mot de passe maître et ta Secret Key, personne ne peut ouvrir ton coffre, pas même nous. Il n'existe aucun moyen de les récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza la password principale e la Secret Key, nessuno può aprire la tua cassaforte, nemmeno noi. Non esiste alcun modo per recuperarle."
          }
        }
      }
    },
