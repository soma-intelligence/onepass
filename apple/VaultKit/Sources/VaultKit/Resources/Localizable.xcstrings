    "emergencyKit.ifThinkSomeoneElse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you think someone else has seen this page, create a new account and move your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si crees que otra persona ha visto esta página, crea una cuenta nueva y traslada tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu penses que cette page a été vue par quelqu'un d'autre, crée un nouveau compte et déplace tes données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pensi che qualcun altro abbia visto questa pagina, crea un nuovo account e sposta i tuoi dati."
          }
        }
      }
    },
    "emergencyKit.itNotPrintedOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is not printed on this kit. If you choose to keep it on paper, write it by hand on the line below, never in a file or a photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está impresa en este kit. Si decides guardarla en papel, escríbela a mano en la línea de abajo, nunca en un archivo ni en una foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'est pas imprimé sur ce kit. Si tu choisis de le garder sur papier, écris-le à la main sur la ligne ci-dessous, jamais dans un fichier ni une photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stampata su questo kit. Se scegli di conservarla su carta, scrivila a mano sulla riga qui sotto, mai in un file o in una foto."
          }
        }
      }
    },
    "emergencyKit.keyWorksWithMaster" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This key works with your master password to protect your vault. It's stored on your devices and never sent to anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave se suma a tu contraseña maestra para proteger tu bóveda. Se guarda en tus dispositivos y nunca se envía a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé s'ajoute à ton mot de passe maître pour protéger ton coffre. Elle est stockée sur tes appareils et n'est jamais envoyée à personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chiave si aggiunge alla password principale per proteggere la tua cassaforte. È salvata sui tuoi dispositivi e non viene mai inviata a nessuno."
          }
        }
      }
    },
    "emergencyKit.kitPlusMasterPassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This kit plus your master password give full access to your vault. Print it and keep the sheet offline. Never take a photo of it and never store it in the cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este kit y tu contraseña maestra dan acceso completo a tu bóveda. Imprímelo y guarda la hoja sin conexión. Nunca le hagas una foto ni lo guardes en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce kit plus ton mot de passe maître donnent un accès complet à ton coffre. Imprime-le et range la feuille hors ligne. Ne le photographie jamais et ne le stocke jamais dans le cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo kit più la password principale danno accesso completo alla tua cassaforte. Stampalo e conserva il foglio offline. Non fotografarlo mai e non salvarlo mai nel cloud."
          }
        }
      }
    },
    "emergencyKit.masterPassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your master password"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña maestra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton mot de passe maître"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua password principale"
          }
        }
      }
    },
    "emergencyKit.printKitAndKeep" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print this kit and keep the sheet offline, somewhere safe (a safe, a locked drawer). Never take a photo of it and never store it in the cloud (iCloud Drive, Photos, messaging apps)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime este kit y guarda la hoja sin conexión, en un lugar seguro (una caja fuerte, un cajón con llave). Nunca le hagas una foto ni lo guardes en la nube (iCloud Drive, Fotos, apps de mensajería)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime ce kit et range la feuille hors ligne, dans un endroit sûr (coffre, tiroir fermé à clé). Ne la photographie jamais et ne la stocke jamais dans le cloud (iCloud Drive, Photos, messageries)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stampa questo kit e conserva il foglio offline, in un luogo sicuro (una cassaforte, un cassetto chiuso a chiave). Non fotografarlo mai e non salvarlo mai nel cloud (iCloud Drive, Foto, app di messaggistica)."
          }
        }
      }
    },
    "emergencyKit.scanQrCodeWith" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan this QR code with OnePass on your iPhone or iPad to add a device. On a Mac, type the Secret Key by hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea este código QR con OnePass en tu iPhone o iPad para añadir un dispositivo. En un Mac, escribe la Secret Key a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne ce QR code avec OnePass sur ton iPhone ou ton iPad pour ajouter un appareil. Sur un Mac, tape la Secret Key à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona questo codice QR con OnePass su iPhone o iPad per aggiungere un dispositivo. Su un Mac, digita la Secret Key a mano."
          }
        }
      }
    },
    "emergencyKit.secretKey" : {
      "extractionState" : "manual",
      "localizations" : {
