    "errorText.onepassMadeRequestSystem" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das System hat eine Anfrage von OnePass abgelehnt. Aktualisiere OnePass. Wenn der Fehler wieder auftritt, wende dich an den Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass made a request the system refused. Update OnePass. If it happens again, contact support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass ha hecho una solicitud que el sistema rechaza. Actualiza OnePass. Si vuelve a ocurrir, contacta con el soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass a fait une demande que le système refuse. Mets à jour OnePass. Si l'erreur revient, contacte le support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnePass ha fatto una richiesta che il sistema rifiuta. Aggiorna OnePass. Se succede di nuovo, contatta l'assistenza."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시스템이 OnePass의 요청을 거부했어요. OnePass를 업데이트해 주세요. 오류가 반복되면 고객 지원에 문의해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "系统拒绝了 OnePass 的请求。请更新 OnePass。如果错误再次出现，请联系支持。"
          }
        }
      }
    },
